<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">    
<mapper namespace="com.nis.modules.module.dao.ModuleDao">
	
	<resultMap type="com.nis.modules.module.entity.Module" id="module">
        <result property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="port" column="port"/>
        <result property="param" column="param"/>
        <result property="path" column="path"/>
        <result property="remark" column="remark"/>
        <result property="name" column="name"/>
        
        <association property="project" columnPrefix="p_" javaType="com.nis.modules.project.entity.Project">
	    	<id column="id" property="id"/>
	    	<result column="name" property="name"/>
	    	<result column="remark" property="remark"/>
	    </association>
    </resultMap>
	
	<select id="queryPage" resultMap="module">
       SELECT m.*,
       p.id AS p_id,
       p.name AS p_name,
       p.remark AS p_remark 
       FROM module m left join project p on m.project_id=p.id where 1=1

        <if test="params.id != null and params.id != ''">
            AND m.id = #{params.id}
        </if>

		<if test="params.projectId != null and params.projectId != ''">
            AND m.project_id = #{params.projectId}
        </if>
        
        <if test="params.port != null and params.port != ''">
            AND m.port = #{params.port}
        </if>
        
        <if test="params.name != null and params.name != ''">
        	AND m.name LIKE
            <if test="_databaseId == 'oracle'">'%'||#{params.name}||'%'</if>
            <if test="_databaseId == 'mysql'">CONCAT('%', #{params.name}, '%')</if>
            <if test="_databaseId == 'postgresql'">CONCAT('%', #{params.name}, '%')</if>
        </if>
        
        <if test="params.param != null and params.param != ''">
        	AND m.param LIKE 
            <if test="_databaseId == 'oracle'">'%'||#{params.param}||'%'</if>
            <if test="_databaseId == 'mysql'">CONCAT('%', #{params.param}, '%')</if>
            <if test="_databaseId == 'postgresql'">CONCAT('%', #{params.param}, '%')</if>
        </if>
        
        <if test="params.path != null and params.path != ''">
        	AND m.path LIKE
            <if test="_databaseId == 'oracle'">'%'||#{params.path}||'%'</if>
            <if test="_databaseId == 'mysql'">CONCAT('%', #{params.path}, '%')</if>
            <if test="_databaseId == 'postgresql'">CONCAT('%', #{params.path}, '%')</if>
        </if>
        
    </select>
	
	<select id="selectModuleIdsByProjectIds" resultType="java.lang.Integer">
		select id from module where project_id in 
		<foreach item="projectId" collection="projectIds" separator="," open="(" close=")" index="">
			#{projectId}
		</foreach>
	</select>
</mapper>