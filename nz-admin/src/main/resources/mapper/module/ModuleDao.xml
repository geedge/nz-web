<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">    
<mapper namespace="com.nis.modules.module.dao.ModuleDao">
	
	<resultMap type="com.nis.modules.module.entity.ModuleEntity" id="moduleEntity">
        <result property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="host" column="host"/>
        <result property="port" column="port"/>
        <result property="param" column="param"/>
        <result property="path" column="path"/>
        <result property="remark" column="remark"/>
        
        <association property="projectEntity" javaType="com.nis.modules.project.entity.ProjectEntity">
	    	<id column="project_id" property="id"/>
	    	<result column="name" property="name"/>
	    	<result column="remark" property="remark"/>
	    </association>
    </resultMap>
	
	<select id="queryPage" resultMap="moduleEntity">
       SELECT * FROM module m left join project p on m.project_id=p.id where 1=1

        <if test="params.id != null and params.id != ''">
            AND m.id = #{params.id}
        </if>

		<if test="params.systemId != null and params.systemId != ''">
            AND m.project_id = #{params.projectId}
        </if>
        
        <if test="params.port != null and params.port != ''">
            AND m.port = #{params.port}
        </if>
        
        <if test="params.host != null and params.host != ''">
        	AND m.host LIKE
            <if test="_databaseId == 'oracle'">'%'||#{params.host}||'%'</if>
            <if test="_databaseId == 'mysql'">CONCAT('%', #{params.host}, '%')</if>
            <if test="_databaseId == 'postgresql'">CONCAT('%', #{params.host}, '%')</if>
        </if>
        
        <if test="params.param != null and params.param != ''">
        	AND m.param LIKE 
            <if test="_databaseId == 'oracle'">'%'||#{params.param}||'%'</if>
            <if test="_databaseId == 'mysql'">CONCAT('%', #{params.param}, '%')</if>
            <if test="_databaseId == 'postgresql'">CONCAT('%', #{params.param}, '%')</if>
        </if>
        
        <if test="params.path != null and params.path != ''">
        	AND m.path LIKE
            <if test="_databaseId == 'oracle'">'%'||#{params.path}||'%'</if>
            <if test="_databaseId == 'mysql'">CONCAT('%', #{params.path}, '%')</if>
            <if test="_databaseId == 'postgresql'">CONCAT('%', #{params.path}, '%')</if>
        </if>
        
    </select>
	
	
</mapper>