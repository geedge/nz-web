<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">    
<mapper namespace="com.nis.modules.romote.dao.AccountDao">
	<resultMap id="accountMap" type="com.nis.modules.romote.entity.Account">
        <result property="id" column="id"></result>
        <result property="user" column="user"></result>
        <result property="pwd" column="pwd"></result>
        <result property="authType" column="auth_type"></result>
        <result property="privateKey" column="private-key"></result>
        <association property="asset" select="getAssetById" column="asset_id"></association>
    </resultMap>
    <select id="getCount" resultType="Integer">
        SELECT COUNT(*) FROM `account` a LEFT JOIN asset b on a.asset_id=b.id where a.`user`=#{user}and b.`host`=#{host}
    </select>
	<select id="getAssetById" resultType="com.nis.modules.asset.entity.Asset">
        select * from asset where id=#{id}
    </select>

    <select id="getAccountById" resultMap="accountMap">
        select * from account where id=#{id}
    </select>
</mapper>