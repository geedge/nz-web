<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">    
<mapper namespace="com.nis.modules.project.dao.TopoIconDao">


    <select id="queryIconList" resultType="com.nis.modules.project.entity.TopoIcon">
        SELECT
            pti.id,
            pti.NAME,
            pti.type,
            pti.unit,
            pti.width,
            pti.height
        FROM
            project_topo_icon pti
        <where>
            <if test="params.id != null and params.id != ''">
                pti.id = #{params.id}
            </if>

            <if test="params.name != null and params.name != ''">
                AND pti.name LIKE CONCAT('%', #{params.name}, '%')
            </if>
        </where>
    </select>

</mapper>
