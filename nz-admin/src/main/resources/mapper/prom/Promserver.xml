<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.promserver.dao.PromserverDao">

	<update id="updateStatusInfo">
		update prom_server set status=#{promserver.status},check_time=#{promserver.checkTime},status_info=#{promserver.statusInfo} where id=#{promserver.id}
	</update>
</mapper>
