<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.nis.modules.integration.dao.IntMetadataDao">

    <resultMap type="com.nis.modules.integration.entity.IntMetadataEntity" id="intMetadata">
        <result property="id" column="id"/>
        <result property="name" column="name" />
        <result property="intModuleId" column="int_module_id" />
        <result property="remark" column="remark" />
        <result property="type" column="type" />
        <result property="status" column="status" />
        <result property="buildIn" column="build_in" />
        <result property="uid" column="uid" />
        <result property="uts" column="uts" />

        <association property="intModule" columnPrefix="im_" javaType="com.nis.modules.integration.entity.IntModuleEntity">
            <id column="id" property="id"/>
            <result column="name" property="name"/>
        </association>
    </resultMap>

    <select id="queryList" resultMap="intMetadata">
        SELECT
            imd.*,
            im.id as im_id,
            im.name as im_name
        FROM
        int_metadata imd left join int_module im on im.id = imd.int_module_id
        <where>
            <if test="params.moduleIds != null and params.moduleIds.size > 0">
                im.id IN
                <foreach collection="params.moduleIds" item="id" index="no" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="params.name != null and params.name != ''">
                AND locate(#{params.name} , imd.name)
            </if>
            <if test="params.moduleName != null and params.moduleName != ''">
                AND locate(#{params.moduleName} , im.name)
            </if>
        </where>
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY imd.id
        </if>
    </select>
</mapper>