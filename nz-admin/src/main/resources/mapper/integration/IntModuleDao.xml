<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.nis.modules.integration.dao.IntModuleDao">

    <resultMap id="intModule" type="com.nis.modules.integration.entity.IntModuleEntity">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="remark" column="remark"/>
        <result property="icon" column="icon"/>
        <result property="configuration" column="configuration"/>
        <result property="tempId" column="tempId"/>
        <result property="status" column="status"/>
        <result property="buildIn" column="build_in"/>
        <result property="uts" column="uts"/>
        <result property="uid" column="uid"/>
    </resultMap>

    <select id="queryList" resultMap="intModule">
        SELECT
        im.*
        FROM
        int_module im
        <where>
            <if test="param.name != null and param.name != ''">
                locate(#{param.name} , im.name)
            </if>
        </where>
        <if test="param.orderBy == null or param.orderBy == ''">
            ORDER BY im.id
        </if>
    </select>

    <select id="queryInfo" resultMap="intModule">
        SELECT
        im.*
        FROM
        int_module im
        <where>
            <if test="id != null and id != ''">
                locate(#{id} , im.id)
            </if>
        </where>
    </select>
</mapper>