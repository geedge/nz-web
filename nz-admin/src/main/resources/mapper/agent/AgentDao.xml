<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.agent.dao.AgentDao">

	<resultMap type="com.nis.modules.agent.entity.Agent" id="agentInfoMap">
	<result property="id" column="id"/>
	<result property="dcId" column="dc_id"/>
	<result property="host" column="host"/>
	<result property="port" column="port"/>
	<result property="type" column="type"/>
	<result property="status" column="status"/>
	<result property="protocol" column="protocol"/>
	<result property="statusInfo" column="status_info"/>
	<result property="token" column="token"/>
	<result property="name" column="name"/>

	<association property="dc" columnPrefix="d_" javaType="com.nis.modules.asset.entity.Dc">
		<id property="id" column="id"/>
		<result property="name" column="name"/>
	</association>
	</resultMap>

	<update id="updateStatusInfo">
		update agent set protocol=#{agent.protocol},status=#{agent.status},status_info=#{agent.statusInfo} where id=#{agent.id}
	</update>

	<select id="queryList" resultMap="agentInfoMap">
		SELECT
			ps.*,
			dc.id AS d_id,
			dc.NAME AS d_name
		FROM
			agent ps
			LEFT JOIN dc dc ON ps.dc_id = dc.id
		<where>
			<if test="params.ids != null">
				ps.id in
				<foreach item="id" collection="params.ids" separator="," open="(" close=")" index="">
					#{id}
				</foreach>
			</if>

			<if test="params.dcIds != null">
				AND ps.dc_id in
				<foreach item="dcId" collection="params.dcIds" separator="," open="(" close=")" index="">
					#{dcId}
				</foreach>
			</if>

			<if test="params.statuses != null">
				AND ps.status in
				<foreach item="status" collection="params.statuses" separator="," open="(" close=")" index="">
					#{status}
				</foreach>
			</if>

			<if test="params.host != null and params.host != ''">
				AND locate(#{params.host} , ps.host)
			</if>

			<if test="params.port != null and params.port != ''">
				AND ps.port = #{params.port}
			</if>

			<if test="params.token != null and params.token != ''">
				AND ps.token = #{params.token}
			</if>
			
			<if test="params.type != null and params.type != ''">
				AND ps.type = #{params.type}
			</if>
			<if test="params.name != null and params.name != ''">
				AND locate(#{params.name},ps.name) <!--ps.name = #{params.name}-->
			</if>
		</where>
	</select>
</mapper>
