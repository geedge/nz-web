<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.alert.dao.AlertNotifyMethodDao">

    <resultMap id="alertNotifyMethod" type="com.nis.modules.alert.entity.AlertNotifyMethod">
        <id  property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="filePath" column="file_path"/>
        <result property="account" column="account"/>
        <result property="state" column="state"/>
        <result property="buildIn" column="build_in"/>
    </resultMap>

    <select id="queryList" resultType="com.nis.modules.alert.entity.AlertNotifyMethod">
        select
        id,
        name,
        file_path,
        account,
        state,
        build_in
        from alert_notify_method
        <where>
            <if test="params.ids != null and params.ids.length > 0">
                id in
                <foreach collection="params.ids.split(',')" open="(" separator="," close=")" item="id">
                    #{id}
                </foreach>
            </if>
            <if test="params.name != null">
                and locate(#{params.name} , name)
            </if>
            <if test="params.state != null">
                and state  = #{params.state}
            </if>
        </where>
    </select>
</mapper>