<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nis.modules.alert.dao.RecordRuleDao">

    <resultMap type="com.nis.modules.alert.entity.RecordRuleEntity" id="recordRuleMap">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="inr" column="inr"/>
        <result property="expr" column="expr"/>
        <result property="labels" column="labels"/>
        <result property="state" column="state"/>
        <result property="buildIn" column="build_in"/>
        <result property="seq" column="seq"/>
        <result property="startts" column="startts"/>
        <result property="cid" column="cid"/>
        <result property="cts" column="cts"/>
        <result property="uid" column="uid"/>
        <result property="uts" column="uts"/>
        <result property="remark" column="remark"/>
        <result property="starred" column="starred"/>

        <association property="createUser" columnPrefix="c_" javaType="com.nis.modules.sys.entity.SysUserEntity">
            <result property="id" column="id"/>
            <result property="name" column="name"/>
        </association>

        <association property="updateUser" columnPrefix="u_" javaType="com.nis.modules.sys.entity.SysUserEntity">
            <result property="id" column="id"/>
            <result property="name" column="name"/>
        </association>
    </resultMap>
    <select id="queryList" resultMap="recordRuleMap">
        SELECT
            rr.* ,
            c.id as c_id,
            c.name as c_name,
            u.id as u_id,
            u.name as u_name,
            IFNULL( sus.starred, 0 ) AS starred
        from
            record_rule rr
            LEFT JOIN sys_user c on rr.cid = c.id
            LEFT JOIN sys_user u on rr.uid = u.id
            LEFT JOIN ( SELECT IF(COUNT(1) > 0, 1, 0) AS starred,tid FROM sys_user_starred WHERE type = "recordRule" AND uid = #{params.userId} GROUP BY tid) sus ON rr.id = sus.tid
        <where>
            <if test="params.ids != null">
                rr.id in
                <foreach item="id" collection="params.ids" separator="," open="(" close=")" index="">
                    #{id}
                </foreach>
            </if>

            <if test="params.name != null and params.name != ''">
                AND locate(#{params.name} , rr.name)
            </if>

            <if test="params.type != null and params.type != ''">
                AND #{params.type} = rr.type
            </if>

            <if test="params.expr != null and params.expr != ''">
                AND locate(#{params.expr} , rr.expr)
            </if>

            <if test="params.buildIn != null and params.buildIn != ''">
                AND #{params.buildIn} = rr.build_in
            </if>

            <if test="params.state != null and params.state != ''">
                AND #{params.state} = rr.state
            </if>

            <if test="params.starred != null and params.starred != ''">
                AND
                <if test=' params.starred eq 1 '>
                    sus.starred = #{params.starred}
                </if>
                <if test=' params.starred eq 0 '>
                    sus.starred IS NULL
                </if>
            </if>

        </where>
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY rr.id
        </if>
    </select>
</mapper>
