<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.alert.dao.AlertRuleDao">

    <!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.nis.modules.alert.entity.AlertRuleEntity" id="alertRuleMap">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="inr" column="inr"/>
        <result property="timeout" column="timeout"/>
        <result property="expr" column="expr"/>
        <result property="operator" column="operator"/>
        <result property="threshold" column="threshold"/>
        <result property="unit" column="unit"/>
        <result property="method" column="method"/>
        <result property="last" column="last"/>
        <result property="severityId" column="severity_id"/>
        <result property="summary" column="summary"/>
        <result property="description" column="description"/>
        <result property="receiver" column="receiver"/>
        <result property="buildIn" column="build_in"/>
        <result property="state" column="state"/>
        <result property="starred" column="starred"/>

        <result property="autoExpired" column="auto_expired"/>
        <result property="schedEnable" column="sched_enable"/>
        <result property="schedDays" column="sched_days"/>
        <result property="schedStime" column="sched_stime"/>
        <result property="schedEtime" column="sched_etime"/>
        <result property="notifyActive" column="notify_active"/>
        <result property="notifyExpired" column="notify_expired"/>
        <result property="trbShot" column="trb_shot"/>

        <result property="alertNum" column="alertNum"/>
        <association property="severity" javaType="com.nis.modules.alert.entity.AlertSeverityConf" columnPrefix="alsc_">
            <result property="id" column="id"/>
            <result property="name" column="name"/>
            <result property="color" column="color"/>
            <result property="remark" column="remark"/>
        </association>
    </resultMap>

    <select id="queryList" resultMap="alertRuleMap">
		SELECT
			ar.*,
			alsc.id AS alsc_id,
			alsc.NAME AS alsc_name,
			alsc.color AS alsc_color,
			alsc.remark AS alsc_remark,
			IFNULL( am.alertNum, 0 ) AS alertNum,
            IFNULL( sta.starred, 0 ) AS starred
		FROM
			alert_rule ar
			LEFT JOIN ( SELECT rule_id, count( 1 ) AS alertNum FROM alert_message_active GROUP BY rule_id ) am ON ar.id = am.rule_id
			LEFT JOIN alert_severity_conf alsc ON ar.severity_id = alsc.id
            LEFT JOIN ( SELECT IF(COUNT(1) > 0, 1, 0) AS starred,tid FROM sys_user_starred WHERE TYPE = "alertRule" AND uid = #{params.currentLoginUserID} GROUP BY tid) sta ON ar.id = sta.tid
        <where>

            <if test="params.ids != null and params.ids != ''">
                ar.id in
                <foreach collection="params.ids.split(',')" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>

            <if test="params.name != null and params.name != ''">
                AND locate(#{params.name} , ar.name)
            </if>

            <if test="params.type != null and params.type != ''">
                AND ar.type = #{params.type}
            </if>

            <if test="params.expr != null and params.expr != ''">
                AND locate(#{params.expr} , ar.expr)
            </if>

            <if test="params.last != null and params.last != ''">
                AND ar.last = #{params.last}
            </if>

            <if test="params.severityIds != null and params.severityIds != ''">
                AND ar.severity_id in
                <foreach collection="params.severityIds.split(',')" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>

            <if test="params.summary != null and params.summary != ''">
                AND locate( #{params.summary} , ar.summary)
            </if>

            <if test="params.description != null and params.description != ''">
                AND locate(#{params.description} , ar.description)
            </if>

            <if test="params.buildIn != null and params.buildIn != ''">
                AND ar.build_in = #{params.buildIn}
            </if>

            <if test="params.state != null and params.state != ''">
                AND ar.state = #{params.state}
            </if>

            <if test="params.starred != null and params.starred != ''">
                AND
                <if test=' params.starred eq 1 '>
                    starred = #{params.starred}
                </if>
                <if test=' params.starred eq 0 '>
                    starred IS NULL
                </if>
            </if>

            <if test="receivers != null and receivers.size > 0">
                <choose>
                    <when test="receivers.size == 1">
                        AND FIND_IN_SET(#{receivers[0]}, receiver)
                    </when>
                    <otherwise>
                        AND FIND_IN_SET(#{receivers[0]}, receiver)
                        <foreach item="receiver" collection="receivers" index="">
                            OR FIND_IN_SET(#{receiver}, receiver)
                        </foreach>
                    </otherwise>
                </choose>
            </if>
        </where>

        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY ar.id
        </if>
    </select>

    <select id="nzAlertMumsMetric" resultType="com.nis.modules.metric.dto.MetricsDto">
        SELECT
            ar.id,
            ar.name,
            sc.name AS severity,
            count( DISTINCT am.id ) as total
        FROM
            alert_rule ar
            LEFT JOIN alert_severity_conf sc ON ar.severity_id = sc.id
            LEFT JOIN alert_message_active am ON ar.id = am.rule_id
        GROUP BY
            ar.id
    </select>

    <update id="delNotify">
        UPDATE alert_rule rule
        LEFT JOIN (
            SELECT
                t.id,
                ifnull( GROUP_CONCAT(case methodid
                    <foreach collection="list" item="item" separator=" " >
                         when #{item} then null
                    </foreach>
                else methodid end), '' ) ids
            FROM
            (
                SELECT
                    id,
                    SUBSTRING_INDEX( SUBSTRING_INDEX( method, ',', ht.help_topic_id + 1 ), ',', - 1 ) AS methodid
                FROM
                    alert_rule
                INNER JOIN ( SELECT @rownum := @rownum + 1 AS help_topic_id FROM ( SELECT @rownum :=- 1 ) t, alert_rule ) ht ON ht.help_topic_id &lt; ( LENGTH( method ) - LENGTH( REPLACE ( method, ',', '' ) ) + 1 ) WHERE LENGTH( method ) > 0
            ) t
            GROUP BY
            t.id
        ) s ON rule.id = s.id
        SET rule.method = s.ids
        WHERE
            s.id IS NOT NULL
    </update>
</mapper>
