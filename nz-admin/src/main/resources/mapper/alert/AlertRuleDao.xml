<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.alert.dao.AlertRuleDao">

    <!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.nis.modules.alert.entity.AlertRuleEntity" id="alertRuleMap">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="expr" column="expr"/>
        <result property="operator" column="operator"/>
        <result property="threshold" column="threshold"/>
        <result property="unit" column="unit"/>
        <result property="method" column="method"/>
        <result property="last" column="last"/>
        <result property="severityId" column="severity_id"/>
        <result property="summary" column="summary"/>
        <result property="description" column="description"/>
        <result property="receiver" column="receiver"/>
        <result property="buildIn" column="buildIn"/>
        <result property="alertNum" column="alertNum"/>
        <association property="severity" javaType="com.nis.modules.alert.entity.AlertSeverityConf" columnPrefix="alsc_">
            <result property="id" column="id"/>
            <result property="name" column="name"/>
            <result property="color" column="color"/>
            <result property="remark" column="remark"/>
        </association>
    </resultMap>

    <select id="queryList" resultMap="alertRuleMap">
		SELECT
			ar.id,
			ar.NAME AS NAME,
			ar.expr,
			ar.operator,
			ar.threshold,
			ar.unit,
			ar.last,
			ar.severity_id,
			ar.summary,
			ar.description,
			ar.receiver,
			ar.method,
			alsc.id AS alsc_id,
			alsc.NAME AS alsc_name,
			alsc.color AS alsc_color,
			alsc.remark AS alsc_remark,
			ar.build_in AS buildIn,
			IFNULL(am.alertNum,0)  AS alertNum
		FROM
			alert_rule ar
			LEFT JOIN (select rule_id,count(1) as alertNum from alert_message_active GROUP BY rule_id) am ON ar.id = am.rule_id
			LEFT JOIN alert_severity_conf alsc ON ar.severity_id = alsc.id
        <where>

            <if test="params.ids != null and params.ids != ''">
                ar.id in
                <foreach collection="params.ids.split(',')" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>

            <if test="params.name != null and params.name != ''">
                AND ar.name LIKE CONCAT('%', #{params.name}, '%')
            </if>

            <if test="params.expr != null and params.expr != ''">
                AND ar.expr LIKE CONCAT('%', #{params.expr}, '%')
            </if>

            <if test="params.last != null and params.last != ''">
                AND ar.last = #{params.last}
            </if>

            <if test="params.severityIds != null and params.severityIds != ''">
                AND ar.severity_id in
                <foreach collection="params.severityIds.split(',')" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>

            <if test="params.summary != null and params.summary != ''">
                AND ar.summary LIKE CONCAT('%', #{params.summary}, '%')
            </if>

            <if test="params.description != null and params.description != ''">
                AND ar.description LIKE CONCAT('%', #{params.description}, '%')
            </if>

            <if test="params.buildIn != null and params.buildIn != ''">
                AND ar.build_in = #{params.buildIn}
            </if>

            <if test="receivers != null and receivers.size > 0">
                <choose>
                    <when test="receivers.size == 1">
                        AND FIND_IN_SET(#{receivers[0]}, receiver)
                    </when>
                    <otherwise>
                        AND FIND_IN_SET(#{receivers[0]}, receiver)
                        <foreach item="receiver" collection="receivers" index="">
                            OR FIND_IN_SET(#{receiver}, receiver)
                        </foreach>
                    </otherwise>
                </choose>
            </if>
        </where>
    </select>

    <select id="nzAlertMumsMetric" resultType="com.nis.modules.metric.dto.MetricsDto">
        SELECT
            ar.id,
            ar.name,
            sc.name AS severity,
            count( DISTINCT am.id ) as total
        FROM
            alert_rule ar
            LEFT JOIN alert_severity_conf sc ON ar.severity_id = sc.id
            LEFT JOIN alert_message_active am ON ar.id = am.rule_id
        GROUP BY
            ar.id
    </select>

</mapper>
