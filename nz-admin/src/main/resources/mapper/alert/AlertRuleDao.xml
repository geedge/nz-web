<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.alert.dao.AlertRuleDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.nis.modules.alert.entity.AlertRuleEntity" id="alertRuleMap">
        <result property="id" column="id"/>
        <result property="alertName" column="alert_name"/>
        <result property="expr" column="expr"/>
        <result property="last" column="last"/>
        <result property="type" column="type"/>
        <result property="severity" column="severity"/>
        <result property="summary" column="summary"/>
        <result property="description" column="description"/>
        <result property="receiver" column="receiver"/>
        <result property="linkId" column="link_id" />
    </resultMap>
    
    <resultMap type="com.nis.modules.alert.entity.AlertNameMapUserDTO" id="alertRuleMapUser">
        <result property="ruleId" column="ruleId"/>
        <result property="receiver" column="receiver"/>
        <collection property="users" ofType="com.nis.modules.sys.entity.SysUserEntity">
	        <result property="email" column="email"/>
        </collection>
    </resultMap>

	<select id="queryUserByRuleIds" resultMap="alertRuleMapUser">
		SELECT 
			a.id ruleId,
			a.receiver,
			u.email
		FROM alert_rule a
		LEFT JOIN user_group_rel ugr ON ugr.group_id=a.receiver
		LEFT JOIN sys_user u ON ugr.user_id=u.user_id
		WHERE 
			a.id in
			<foreach item="ruleId" collection="ruleIds" separator="," open="(" close=")" index="">
				#{ruleId}
			</foreach>
	</select>

    <select id="queryIdsByAlertName" resultType="integer">
        select id from alert_rule where alert_name like concat('%',#{alertName},'%')
    </select>
    
    <delete id="deleteByTypeIds">
    	delete from alert_rule where type=#{typeId} and link_id in
    	<foreach item="id" collection="ids" separator="," open="(" close=")" index="">
			#{id}
		</foreach>
    </delete>
</mapper>