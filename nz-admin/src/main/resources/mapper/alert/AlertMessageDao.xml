	<select id="queryAlertMessageStatisticsInfoByRule" resultType="com.nis.modules.metric.dto.MetricsDto">
		SELECT
			count( am.id ) total,
			rule_id id
		FROM
			alert_message_active am
		GROUP BY
			am.rule_id
	</select>


