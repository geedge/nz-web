<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.alert.dao.AlertMessageDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.nis.modules.alert.entity.AlertMessageEntity" id="alertMessageMap">
        <result property="id" column="id"/>
        <result property="severity" column="severity"/>
        <result property="summary" column="summary"/>
        <result property="description" column="description"/>
        <result property="labels" column="labels"/>
        <result property="startAt" column="start_at"/>
        <result property="endAt" column="end_at"/>
        <result property="state" column="state"/>
		<result property="hashKey" column="hash_key"/>
		<result property="alertRule.id" column="rule_id" />
		<result property="alertRule.alertName" column="alert_name"/>
		<result property="alertRule.expr" column="expr"/>
		<result property="alertRule.operator" column="operator"/>
		<result property="alertRule.threshold" column="threshold"/>
		<result property="alertRule.unit" column="unit"/>
		<result property="alertRule.buildIn" column="build_in"/>

		<result property="projectId" column="project_id"/>
		<result property="moduleId" column="module_id"/>
		<result property="endpointId" column="endpoint_id"/>
		<result property="assetId" column="asset_id"/>
		<result property="dcId" column="dc_id"/>

		<association columnPrefix="p_" property="project" javaType="com.nis.modules.project.entity.Project">
			<id column="id" property="id"/>
			<result column="name" property="name"/>
			<result column="remark" property="remark"/>
			<result column="buildIn" property="buildIn"/>
		</association>

		<association columnPrefix="m_" property="module" javaType="com.nis.modules.module.entity.Module">
			<id column="id" property="id"/>
			<result column="name" property="name"/>
			<result column="port" property="port"/>
			<result column="type" property="type"/>
			<result column="param" property="param"/>
			<result column="path" property="path"/>
			<result column="remark" property="remark"/>
			<result column="buildIn" property="buildIn"/>
			<result column="labels" property="labels"/>
		</association>

		<association columnPrefix="ass_" property="asset" javaType="com.nis.modules.asset.entity.Asset">
			<id column="id" property="id"/>
			<result column="host" property="host"/>
			<result column="sn" property="sn"/>
			<result column="modelId" property="modelId"/>
			<result column="idcId" property="idcId"/>
			<result column="cabinetId" property="cabinetId"/>
			<result column="state" property="state"/>
			<result column="cabinetStart" property="cabinetStart"/>
			<result column="cabinetEnd" property="cabinetEnd"/>
			<result column="purchaseDate" property="purchaseDate"/>
			<result column="createAt" property="createAt"/>
			<result column="updateAt" property="updateAt"/>
			<result column="createBy" property="createBy"/>
			<result column="updateBy" property="updateBy"/>

		</association>
    </resultMap>

	<select id="list" resultMap="alertMessageMap">
		SELECT
			am.*,
			ar.alert_name,
			ar.expr,
			ar.operator,
			ar.threshold,
			ar.unit,
			ar.build_in,

			p.id as p_id,
			p.name as p_name,
			p.remark as p_remark,
			p.build_in as p_buildIn,

			m.id as m_id,
			m.type as m_type,
			m.name as m_name,
			m.port as m_port,
			m.param as m_param,
			m.path as m_path,
			m.remark as m_remark,
			m.build_in as m_buildIn,
			m.labels as m_labels,

			ass.id as ass_id,
			ass.sn as ass_sn,
			ass.host as ass_host,
			ass.model_id as ass_modelId,
			ass.idc_id as ass_idcId,
			ass.cabinet_id as ass_cabinetId,
			ass.cabinet_start as ass_cabinetStart,
			ass.cabinet_end as ass_cabinetEnd,
			ass.state as ass_state,
			ass.purchase_date as ass_purchaseDate,
			ass.create_at as ass_createAt,
			ass.update_at as ass_updateAt,
			ass.create_by as ass_createBy,
			ass.update_by as ass_updateBy
		FROM
			alert_message am
		LEFT JOIN alert_rule ar ON am.rule_id = ar.id
		LEFT JOIN project p on am.project_id = p.id
		LEFT JOIN module m on am.module_id = m.id
		LEFT JOIN asset ass on am.asset_id = ass.id
		<where>
			<if test="params.alertName != null and params.alertName != ''">
				ar.alert_name like concat('%', #{params.alertName}, '%')
			</if>

			<if test="params.severity != null and params.severity != ''">
				AND am.severity=#{params.severity}
			</if>

			<if test="params.summary != null and params.summary != ''">
				AND am.summary like concat('%', #{params.summary}, '%')
			</if>

			<if test="params.description != null and params.description != ''">
				AND am.description like concat('%', #{params.description}, '%')
			</if>

			<if test="params.id != null and params.id != ''">
				AND am.id=#{params.id}
			</if>
            <if test="params.state != null and params.state != ''">
                AND am.state=#{params.state}
            </if>
			<if test="params.startAt != null">
				AND am.start_at &gt;= #{params.startAt}
			</if>
			<if test="params.endAt != null">
				AND am.start_at &lt;= #{params.endAt}
			</if>

			<if test="params.ruleId != null and params.ruleId != ''">
				AND am.rule_id = #{params.ruleId}
			</if>

			<if test="params.projectId != null and params.projectId != ''">
				AND am.project_id = #{params.projectId}
			</if>

			<if test="params.moduleId != null and params.moduleId != ''">
				AND am.module_id = #{params.moduleId}
			</if>

			<if test="params.endpointId != null and params.endpointId != ''">
				AND am.endpoint_id = #{params.endpointId}
			</if>

			<if test="params.assetId != null and params.assetId != ''">
				AND am.asset_id = #{params.assetId}
			</if>

			<if test="params.dcId != null and params.dcId != ''">
				AND am.dc_id = #{params.dcId}
			</if>

			<if test="params.labels != null and params.labels != ''">
				AND am.labels = #{params.labels}
			</if>


			<if test="params.projectName != null and params.projectName != ''">
				AND p.name LIKE concat('%', #{params.projectName}, '%')
			</if>

			<if test="params.moduleName != null and params.moduleName != ''">
				AND m.name LIKE concat('%', #{params.moduleName}, '%')
			</if>

			<if test="params.asset != null and params.asset != ''">
				AND (
				   ass.host LIKE CONCAT('%', #{params.asset}, '%')
				OR ass.sn LIKE CONCAT('%', #{params.asset}, '%')
				)
			</if>

		</where>

		/* 如果排序字段为null , 使用默认排序 */
		<if test="params.orderBy == null or params.orderBy == ''">
			ORDER BY am.state , am.start_at DESC
		</if>
	</select>

	<update id="updateBatch">
		 UPDATE alert_message am SET am.state = 2, am.end_at = #{nowDate}
		 WHERE am.hash_key IN
		<foreach collection="hashKeys" item="hashKey" index="no" open="(" separator="," close=")">
			#{hashKey}
		</foreach>
		AND state = 1
	</update>

	<delete id="deleteByAssetIds">
		delete from alert_message where asset_id in
		<foreach item="id" collection="ids" separator="," open="(" close=")" index="">
			#{id}
		</foreach>
	</delete>

	<delete id="deleteByModuleIds">
		delete from alert_message where module_id in
		<foreach item="id" collection="ids" separator="," open="(" close=")" index="">
			#{id}
		</foreach>
	</delete>

	<delete id="deleteByProjectIds">
		delete from alert_message where project_id in
		<foreach item="id" collection="ids" separator="," open="(" close=")" index="">
			#{id}
		</foreach>
	</delete>

	<delete id="deleteByEndpointIds">
		delete from alert_message where endpoint_id in
		<foreach item="id" collection="ids" separator="," open="(" close=")" index="">
			#{id}
		</foreach>
	</delete>

	<delete id="deleteByDCIds">
		delete from alert_message where dc_id in
		<foreach item="id" collection="ids" separator="," open="(" close=")" index="">
			#{id}
		</foreach>
	</delete>

	<select id="queryAlertMessageStatisticsInfoByRule" resultType="com.nis.modules.metric.dto.MetricsDto">
		SELECT
			count( am.id ) total,
			rule_id id
		FROM
			alert_message am
		WHERE
			am.state = 1
		GROUP BY
			am.rule_id
	</select>


	<update id="updateAlertStateByIds">
		update alert_message am set remark = #{params.remark} , state = #{params.state}
		<if test="params.endAt != null and params.endAt != ''">
			, end_at = #{params.endAt}
		</if>
		where id in
		<foreach collection="ids" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
	</update>

	<select id="getAlertsStatColumn" resultType="com.nis.modules.alert.entity.AlertMessageEntity">
		SELECT
			severity,
			rule_id,
			project_id,
			module_id,
			asset_id,
			endpoint_id,
			dc_id
		FROM
			alert_message
		WHERE
			state = 1
	</select>

</mapper>
