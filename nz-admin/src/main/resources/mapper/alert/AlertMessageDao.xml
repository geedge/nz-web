	<select id="list" resultMap="alertMessageMap">
		SELECT
			am.*,
			ar.name,
			ar.expr,
			ar.operator,
			ar.threshold,
			ar.unit,
			ar.build_in,

			p.id as p_id,
			p.name as p_name,
			p.remark as p_remark,
			p.build_in as p_buildIn,

			m.id as m_id,
			m.type as m_type,
			m.name as m_name,
			m.port as m_port,
			m.param as m_param,
			m.path as m_path,
			m.remark as m_remark,
			m.build_in as m_buildIn,
			m.labels as m_labels,

			ass.id as ass_id,
			ass.sn as ass_sn,
			ass.host as ass_host,
			ass.model_id as ass_modelId,
			ass.idc_id as ass_idcId,
			ass.cabinet_id as ass_cabinetId,
			ass.cabinet_start as ass_cabinetStart,
			ass.cabinet_end as ass_cabinetEnd,
			ass.state as ass_state,
			ass.purchase_date as ass_purchaseDate,
			ass.create_at as ass_createAt,
			ass.update_at as ass_updateAt,
			ass.create_by as ass_createBy,
			ass.update_by as ass_updateBy,

			alsc.id as alsc_id,
			alsc.name as alsc_name,
			alsc.color as alsc_color,
			alsc.remark as alsc_remark,
			alsc.methods as alsc_methods
		FROM
			alert_message am
		LEFT JOIN alert_rule ar ON am.rule_id = ar.id
		LEFT JOIN project p on am.project_id = p.id
		LEFT JOIN module m on am.module_id = m.id
		LEFT JOIN asset ass on am.asset_id = ass.id
		LEFT JOIN alert_severity_conf alsc on am.severity_id = alsc.id
		<where>
			<if test="params.ruleName != null and params.ruleName != ''">
				ar.name like concat('%', #{params.ruleName}, '%')
			</if>

			<if test="params.severityIds != null and params.severity != ''">
				AND am.severity_id in
				<foreach collection="params.severityIds.split(',')" item="id" open="(" separator="," close=")">
					#{id}
				</foreach>
			</if>

			<if test="params.summary != null and params.summary != ''">
				AND am.summary like concat('%', #{params.summary}, '%')
			</if>

			<if test="params.description != null and params.description != ''">
				AND am.description like concat('%', #{params.description}, '%')
			</if>

			<if test="params.ids != null and params.ids != ''">
				am.id in
				<foreach collection="params.ids.split(',')" item="id" open="(" separator="," close=")">
					#{id}
				</foreach>
			</if>
            <if test="params.state != null and params.state != ''">
                AND am.state=#{params.state}
            </if>
			<if test="params.startAt != null">
				AND am.start_at &gt;= #{params.startAt}
			</if>
			<if test="params.endAt != null">
				AND am.start_at &lt;= #{params.endAt}
			</if>

			<if test="params.ruleIds != null and params.ruleIds != ''">
				AND am.rule_id in
				<foreach collection="params.ruleIds.split(',')" item="id" open="(" separator="," close=")">
					#{id}
				</foreach>
			</if>

			<if test="params.projectIds != null and params.projectIds != ''">
				AND am.project_id in
				<foreach collection="params.projectIds.split(',')" item="id" open="(" separator="," close=")">
					#{id}
				</foreach>
			</if>

			<if test="params.moduleIds != null and params.moduleIds != ''">
				AND am.module_id in
				<foreach collection="params.moduleIds.split(',')" item="id" open="(" separator="," close=")">
					#{id}
				</foreach>
			</if>

			<if test="params.endpointIds != null and params.endpointIds != ''">
				AND am.endpoint_id in
				<foreach collection="params.endpointIds.split(',')" item="id" open="(" separator="," close=")">
					#{id}
				</foreach>
			</if>

			<if test="params.assetIds != null and params.assetIds != ''">
				AND am.asset_id in
				<foreach collection="params.assetIds.split(',')" item="id" open="(" separator="," close=")">
					#{id}
				</foreach>
			</if>

			<if test="params.dcIds != null and params.dcIds != ''">
				AND am.dc_id in
				<foreach collection="params.dcIds.split(',')" item="id" open="(" separator="," close=")">
					#{id}
				</foreach>
			</if>

			<if test="params.labels != null and params.labels != ''">
				AND am.labels = #{params.labels}
			</if>


			<if test="params.projectName != null and params.projectName != ''">
				AND p.name LIKE concat('%', #{params.projectName}, '%')
			</if>

			<if test="params.moduleName != null and params.moduleName != ''">
				AND m.name LIKE concat('%', #{params.moduleName}, '%')
			</if>

			<if test="params.asset != null and params.asset != ''">
				AND (
				   ass.host LIKE CONCAT('%', #{params.asset}, '%')
				OR ass.sn LIKE CONCAT('%', #{params.asset}, '%')
				)
			</if>

		</where>

		/* 如果排序字段为null , 使用默认排序 */
		<if test="params.orderBy == null or params.orderBy == ''">
			ORDER BY am.state , am.start_at DESC
		</if>
	</select>-->

