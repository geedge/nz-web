<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.alert.dao.AlertSeverityDao">
    <resultMap id="alertSeverityConf" type="com.nis.modules.alert.entity.AlertSeverityConf">
        <id  property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="color" column="color"/>
        <result property="weight" column="weight"/>
        <result property="remark" column="remark"/>
        <result property="methods" column="methods"/>

    </resultMap>

    <resultMap id="alertNotifyMethod" type="com.nis.modules.alert.entity.AlertNotifyMethod">
        <id  property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="filePath" column="file_path"/>
        <result property="account" column="account"/>
        <result property="state" column="state"/>
        <result property="buildIn" column="build_in"/>
    </resultMap>
    
    <sql id="queryPrefix">
        select
        id ,
        name,
        color,
        weight,
        remark,
        methods
        from alert_severity_conf
    </sql>

    <select id="queryList" resultType="com.nis.modules.alert.entity.AlertSeverityConf">
        <include refid="queryPrefix"></include>
        <where>
            <if test="params.ids != null and params.ids.length > 0">
                id in
                <foreach collection="params.ids.split(',')" open="(" separator="," close=")" item="id">
                    #{id}
                </foreach>
            </if>
            <if test="params.name != null and params.name.length > 0">
                and name like concat('%',#{params.name},'%')
            </if>
        </where>
        order by weight
    </select>

    <update id="saveWeightBatch" >
        <foreach collection="confs" separator=";" item="conf">
            update alert_severity_conf set weight=#{conf.weight} where id = #{conf.id}
        </foreach>
    </update>
</mapper>