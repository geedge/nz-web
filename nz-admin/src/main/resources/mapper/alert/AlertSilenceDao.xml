<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.alert.dao.AlertSilenceDao">

    <!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.nis.modules.alert.entity.AlertSilenceConf" id="alertSilenceConfMap">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="remark" column="remark"/>
        <result property="matchers" column="matchers"/>
        <result property="startAt" column="start_at"/>
        <result property="endAt" column="end_at"/>
        <result property="utime" column="utime"/>
        <result property="state" column="state"/>
        <result property="seq" column="seq"/>
    </resultMap>

    <select id="selectAlertSilenceConfs" resultType="com.nis.modules.alert.entity.AlertSilenceConf">
         select id,name,matchers,remark,start_at,end_at,utime,state
         from alert_silence_conf
         <where>
         	 <if test="params.ids != null and params.ids != ''">
                and id in
                <foreach collection="params.ids.split(',')" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
             </if>
	         <if test="params.name != null and params.name !='' ">
         		and name like concat('%', #{params.name}, '%')
	         </if>
	         <if test="params.remark != null and params.remark !='' ">
         		and remark concat('%', #{params.remark}, '%')
	         </if>
	         <if test="params.matchers != null and params.matchers !='' ">
         		and matchers like concat('%', #{params.matchers}, '%')
	         </if>
	         <if test="params.state != null and params.state !='' ">
	         	and state = #{params.state}
	         </if>
	         <if test="params.startAt != null">
	         	and start_at &gt;= #{params.startAt}
	         </if>
	         <if test="params.endAt != null">
	         	and end_at &lt;= #{params.endAt}
	         </if>
         </where>
    </select>

</mapper>
