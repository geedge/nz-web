<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nis.modules.endpoint.dao.MetadataMetricDao">

    <select id="queryIdsByMetric" resultType="integer">
        select `id` from `metadata_metric` where `metric`=#{metric}
    </select>
    <select id="queryIdByMetric" resultType="integer">
        select `id` from `metadata_metric` where `metric`=#{metric}
    </select>

    <resultMap type="com.nis.modules.endpoint.entity.MetadataMetric" id="metricWithLabels">
        <result property="metric" column="metric"/>

        <collection property="labels" ofType="com.nis.modules.endpoint.entity.MetadataLabel">
            <result property="metricId" column="metric_id"/>
            <result property="name" column="name"/>
            <result property="value" column="value"/>
        </collection>
    </resultMap>


    <select id="getLabelsWithMetric" resultMap="metricWithLabels">
        SELECT  metric.metric,metric.id,label.name,label.value
        FROM metadata_metric metric
        LEFT JOIN metadata_label label on metric.id = label.metric_id
    </select>

    <select id="queryMetricList" resultType="com.nis.modules.endpoint.entity.MetadataMetric">
        select c.* from metadata_metric c where EXISTS(
                select a.metric_id from
                    metadata_label a
                    <if test="moduleId != null">
                        left join module b on a.value=b.name
                    </if>
                    where 1=1
                    <if test="moduleId != null">
                    and  a.name='module' and b.id=#{moduleId}
                    </if>
                    and c.id= a.metric_id
                    GROUP BY a.metric_id
        )
        <if test="metric != null and metric != ''">
            and  c.metric like concat('%',#{metric},'%')
        </if>
    </select>
</mapper>