<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">    
<mapper namespace="com.nis.modules.endpoint.dao.MonitorEndpointDao">
	
	<resultMap type="com.nis.modules.endpoint.entity.MonitorEndpoint" id="endpoint">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="moduleId" column="module_id"/>
        <result property="assetId" column="asset_id"/>
        <result property="hash" column="hash"/>
        <result property="enabled" column="enabled"/>
        <result property="configs" column="configs"/>
        <result property="alertNum" column="alertNum"/>

        <result column="es_state" property="state"/>

        <association columnPrefix="m_" property="module" javaType="com.nis.modules.module.entity.MonitorModule">
	    	<id column="id" property="id"/>
	    	<result column="name" property="name"/>
	    	<result column="type" property="type"/>
	    </association>

	    <association columnPrefix="p_" property="project" javaType="com.nis.modules.project.entity.MonitorProject">
		    <id column="id" property="id"/>
	    	<result column="name" property="name"/>
	    </association>

	    <association columnPrefix="a_" property="asset" javaType="com.nis.modules.asset.entity.AssetAsset">
	    	<id column="id" property="id"/>
	    	<result column="manage_ip" property="manageIp"/>
	    	<result column="sn" property="sn"/>
	    	<result column="cabinet_id" property="cabinetId"/>
	    	<result column="purchase_date" property="purchaseDate"/>
	    	<result column="dc_id" property="dcId"/>
	    	<result column="model_id" property="modelId"/>
	    	<result column="name" property="name"/>
	    </association>
    </resultMap>


    <resultMap type="com.nis.modules.endpoint.entity.MonitorEndpoint" id="endpointInfoByAgent">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="moduleId" column="module_id"/>
        <result property="assetId" column="asset_id"/>
        <result property="hash" column="hash"/>
        <result property="enabled" column="enabled"/>
        <result property="configs" column="configs"/>

        <association columnPrefix="m_" property="module" javaType="com.nis.modules.module.entity.MonitorModule">
            <id column="id" property="id"/>
            <result column="name" property="name"/>
            <result column="project_id" property="projectId"/>
            <result column="configs" property="configs"/>
            <result column="snmp_yml" property="snmpYml"/>
            <result column="type" property="type"/>
        </association>

        <association columnPrefix="p_" property="project" javaType="com.nis.modules.project.entity.MonitorProject">
            <id column="id" property="id"/>
            <result column="name" property="name"/>
        </association>

        <association columnPrefix="ass_" property="asset" javaType="com.nis.modules.asset.entity.AssetAsset">
            <id column="id" property="id"/>
            <result column="manage_ip" property="manageIp"/>
            <result column="sn" property="sn"/>
            <result column="name" property="name"/>
            <result column="dc_id" property="dcId"/>
            <result column="pid" property="pid"/>
        </association>

        <association columnPrefix="dc_" property="dc" javaType="com.nis.modules.asset.entity.Dc">
            <id column="id" property="id"/>
            <result column="name" property="name"/>
        </association>
    </resultMap>

    <resultMap type="com.nis.modules.endpoint.entity.MonitorEndpoint" id="endpointDetail">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="moduleId" column="module_id"/>
        <result property="assetId" column="asset_id"/>
        <result property="hash" column="hash"/>
        <result property="enabled" column="enabled"/>
        <result property="configs" column="configs"/>

        <association columnPrefix="ass_" property="asset" javaType="com.nis.modules.asset.entity.AssetAsset">
            <id column="id" property="id"/>
            <result column="manage_ip" property="manageIp"/>
            <result column="sn" property="sn"/>
            <result column="name" property="name"/>
            <result column="dc_id" property="dcId"/>

            <!--state conf monitor-->
            <result property="state.id" column="state_id"/>
            <result property="state.name" column="state_name"/>
            <result property="state.monitor" column="state_monitor"/>
        </association>

        <association columnPrefix="dc_" property="dc" javaType="com.nis.modules.asset.entity.Dc">
            <id column="id" property="id"/>
            <result column="name" property="name"/>
            <result column="state" property="state"/>
        </association>
    </resultMap>

	
	<select id="queryPage" resultMap="endpoint">
		SELECT
			e.*,
			m.id AS m_id,
			m.NAME AS m_name,
			m.type AS m_type,
			a.id AS a_id,
			a.manage_ip AS a_manage_ip,
			a.sn AS a_sn,
			a.purchase_date AS a_purchase_date,
			a.dc_id AS a_dc_id,
			a.model_id AS a_model_id,
			a.cabinet_id AS a_cabinet_id,
			a.NAME AS a_name,
			p.id AS p_id,
			p.NAME AS p_name,
			es.state AS es_state,
			IFNULL(msg.alertNum,0) AS alertNum
		FROM
			monitor_endpoint e
			LEFT JOIN monitor_module m ON e.module_id = m.id
			LEFT JOIN monitor_project p ON m.project_id = p.id
			LEFT JOIN asset_asset a ON e.asset_id = a.id
			LEFT JOIN monitor_endpoint_state es ON e.id = es.endpoint_id
			LEFT JOIN (select endpoint_id ,count(1) as alertNum from  alert_message_active where endpoint_id is not null group by endpoint_id) msg ON e.id = msg.endpoint_id

        <where>
           <if test="params.ids != null and params.ids.length > 0">
               e.id IN
               <foreach collection="params.ids" item="id" index="no" open="(" separator="," close=")">
                   #{id}
               </foreach>
           </if>

           <if test="params.projectIds != null and params.projectIds.length > 0">
               AND p.id IN
               <foreach collection="params.projectIds" item="projectId" index="no" open="(" separator="," close=")">
                   #{projectId}
               </foreach>
           </if>

           <if test="params.moduleIds != null and params.moduleIds.length > 0">
               AND e.module_id IN
               <foreach collection="params.moduleIds" item="moduleId" index="no" open="(" separator="," close=")">
                   #{moduleId}
               </foreach>
           </if>

            <if test="params.assetIds != null and params.assetIds.length > 0">
                AND a.id IN
                <foreach collection="params.assetIds" item="assetId" index="no" open="(" separator="," close=")">
                    #{assetId}
                </foreach>
            </if>

            <if test="params.states != null and params.states.length > 0">
               AND es.state IN
               <foreach collection="params.states" item="state" index="no" open="(" separator="," close=")">
                   #{state}
               </foreach>

                <if test="params.suspendedStatus != null and params.suspendedStatus != ''">
                    OR es.state >= 2
                </if>
           </if>

           <if test="params.name != null and params.name != ''">
               AND e.name like CONCAT('%', #{params.name}, '%')
           </if>


           <if test="params.assetName != null and params.assetName != ''">
               AND a.name like CONCAT('%', #{params.assetName}, '%')
           </if>

       </where>

        GROUP BY
            e.id
    </select>

    <select id="getSuspendedEndpointIdList" resultType="java.lang.Integer">
        SELECT DISTINCT
            me.id
        FROM
            monitor_endpoint me
            LEFT JOIN asset_asset ass ON me.asset_id = ass.id
            LEFT JOIN asset_state_conf state ON ass.state_id = state.id
        WHERE
            state.monitor = 0
            OR me.enabled = 0

            <if test="assetId != null and assetId != ''">
                AND ass.id = #{assetId}
            </if>
    </select>

    <select id="getEnableEndpointInfoList" resultMap="endpointInfoByAgent">
        SELECT
            e.*,

            m.id AS m_id,
            m.project_id AS m_project_id,
            m.NAME AS m_name,
            m.configs AS m_configs,
            m.snmp_yml AS m_snmp_yml,
            m.type AS m_type,

            p.id AS p_id,
            p.NAME AS p_name,

            ass.id AS ass_id,
            ass.sn AS ass_sn,
            ass.NAME AS ass_name,
            ass.manage_ip AS ass_manage_ip,
            ass.dc_id AS ass_dc_id,
            ass.pid AS ass_pid,

            dc.id AS dc_id,
            dc.NAME AS dc_name
        FROM
            monitor_endpoint e
            LEFT JOIN monitor_module m ON e.module_id = m.id
            LEFT JOIN monitor_project p ON m.project_id = p.id
            LEFT JOIN asset_asset ass ON e.asset_id = ass.id
            LEFT JOIN asset_state_conf state ON ass.state_id = state.id
            LEFT JOIN dc dc ON ass.dc_id = dc.id
        WHERE
            e.enabled = 1 AND state.monitor = 1 AND dc.state = 'ON'
    </select>


    <select id="endpointDetailList" resultMap="endpointDetail">
        SELECT
            e.*,

            ass.id AS ass_id,
            ass.sn AS ass_sn,
            ass.NAME AS ass_name,
            ass.manage_ip AS ass_manage_ip,
            ass.dc_id AS ass_dc_id,

            state.id as ass_state_id,
            state.name as ass_state_name,
            state.monitor as ass_state_monitor,

            dc.id AS dc_id,
            dc.NAME AS dc_name,
            dc.state as dc_state
        FROM
            monitor_endpoint e
            LEFT JOIN asset_asset ass ON e.asset_id = ass.id
            LEFT JOIN asset_state_conf state ON ass.state_id = state.id
            LEFT JOIN dc dc ON ass.dc_id = dc.id
    </select>

</mapper>
