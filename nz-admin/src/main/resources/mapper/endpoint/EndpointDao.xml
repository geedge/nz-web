<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">    
<mapper namespace="com.nis.modules.endpoint.dao.EndpointDao">
	
	<resultMap type="com.nis.modules.endpoint.entity.EndpointEntity" id="endpointEntity">
        <result property="id" column="id"/>
        <result property="moduleId" column="module_id"/>
        <result property="assetId" column="asset_id"/>
        <result property="host" column="host"/>
        <result property="port" column="port"/>
        <result property="param" column="param"/>
        <result property="path" column="path"/>
        
        <association property="moduleEntity" javaType="com.nis.modules.module.entity.ModuleEntity">
	    	<id column="module_id" property="id"/>
	    	<result column="name" property="name"/>
	    	<result column="remark" property="remark"/>
	    	
	    	<association property="projectEntity" column="project_id" select="queryProject">
		    	
	    	</association>
	    </association>
    </resultMap>
	
	<select id="queryPage" resultMap="endpointEntity">
       SELECT * FROM endpoint e left join module m on e.module_id=m.id 
       left join project p on m.project_id=p.id
       where 1=1 
       <if test="params.id != null and params.id != ''">
            AND e.id = #{params.id}
       </if>
       
       <if test="params.projectId != null and params.projectId != ''">
           AND p.id = #{params.projectId}
       </if>
       
       <if test="params.assetId != null and params.assetId != ''">
           AND e.asset_id = #{params.assetId}
       </if>
       
       <if test="params.moduleId != null and params.moduleId != ''">
           AND e.module_id = #{params.moduleId}
       </if>
    </select>
	
	<select id="queryProject" resultType="com.nis.modules.project.entity.ProjectEntity">
       SELECT * FROM project where id=#{id}
        
    </select>
	
</mapper>