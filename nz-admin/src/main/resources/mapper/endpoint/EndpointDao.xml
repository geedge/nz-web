<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">    
<mapper namespace="com.nis.modules.endpoint.dao.EndpointDao">
	
	<resultMap type="com.nis.modules.endpoint.entity.Endpoint" id="endpoint">
        <result property="id" column="id"/>
        <result property="moduleId" column="module_id"/>
        <result property="assetId" column="asset_id"/>
        <result property="host" column="host"/>
        <result property="port" column="port"/>
        <result property="param" column="param"/>
        <result property="path" column="path"/>
        
        <association columnPrefix="m_" property="module" javaType="com.nis.modules.module.entity.Module">
	    	<id column="id" property="id"/>
	    	<result column="name" property="name"/>
	    	<result column="port" property="port"/>
	    	<result column="type" property="type"/>
	    </association>
	    
	    <association columnPrefix="P_" property="project" javaType="com.nis.modules.project.entity.Project">
		    <id column="id" property="id"/>
	    	<result column="name" property="name"/>
	    </association>
	    
	    <association columnPrefix="a_" property="asset" javaType="com.nis.modules.asset.entity.Asset">
	    	<id column="id" property="id"/>
	    	<result column="host" property="host"/>
	    	<result column="sn" property="sn"/>
	    	<result column="cabinet_id" property="cabinetId"/>
	    	<result column="state" property="state"/>
	    	<result column="purchase_date" property="purchaseDate"/>
	    	<result column="idc_id" property="idcId"/>
	    	<result column="model_id" property="modelId"/>
	    </association>
	    
	    <!-- <association columnPrefix="prom_" property="promserver" javaType="com.nis.modules.promserver.entity.Promserver">
	    	<id column="id" property="id"/>
	    	<result column="host" property="host"/>
	    	<result column="port" property="port"/>
	    	<result column="type" property="type"/>
	    	<result column="status" property="status"/>
	    	<result column="idc_id" property="idcId"/>
	    	<result column="check_time" property="checkTime"/>
	    </association> -->
    </resultMap>
	
	<select id="queryPage" resultMap="endpoint">
       SELECT e.*,
       m.id AS m_id,
       m.name AS m_name,
       m.port AS m_port,
       m.type AS m_type,
       a.id AS a_id,
       a.host AS a_host,
       a.sn AS a_sn,
       a.state AS a_state,
       a.purchase_date AS a_purchase_date,
       a.idc_id AS a_idc_id,
       a.model_id AS a_model_id,
       a.cabinet_id AS a_cabinet_id,
       p.id AS p_id,
       p.name AS p_name
       <!-- prom.id AS prom_id,
       prom.host AS prom_host,
       prom.port AS prom_port,
       prom.type AS prom_type,
       prom.status AS prom_status,
       prom.idc_id AS prom_idc_id,
       prom.check_time AS prom_check_time -->
       FROM endpoint e left join module m on e.module_id=m.id 
       left join project p on m.project_id=p.id
       left join asset a on e.asset_id=a.id
       <!-- left join prom_server prom on a.idc_id=prom.idc_id -->
       where 1=1 
       <if test="params.id != null and params.id != ''">
            AND e.id = #{params.id}
       </if>
       
       <if test="params.projectId != null and params.projectId != ''">
           AND p.id = #{params.projectId}
       </if>
       
       <if test="params.assetId != null and params.assetId != ''">
           AND e.asset_id = #{params.assetId}
       </if>
       
       <if test="params.moduleId != null and params.moduleId != ''">
           AND e.module_id = #{params.moduleId}
       </if>
       
       <if test="params.sn != null and params.sn != ''">
           AND a.sn = #{params.sn}
       </if>
       
       <if test="params.modelId != null and params.modelId != ''">
           AND a.model_id = #{params.modelId}
       </if>
       
       <if test="params.idcId != null and params.idcId != ''">
           AND a.idc_id = #{params.idcId}
       </if>
       
       	<if test="params.cabinetId != null and params.cabinetId != ''">
           AND a.cabinet_id = #{params.cabinetId}
       </if>
       
       <if test="params.host != null and params.host != ''">
           AND a.host = #{params.host}
       </if>
       
       <if test="params.state != null and params.state != ''">
           AND a.state = #{params.state}
       </if>
       
       <if test="params.purchaseDate != null and params.purchaseDate != ''">
           AND a.purchase_date = #{params.purchaseDate}
       </if>
       
       <if test="params.pingStatus != null and params.pingStatus != ''">
           AND a.ping_status = #{params.pingStatus}
       </if>
       
       <if test="params.idcIds != null and params.idcIds != ''">
       	 AND a.idc_id in (#{params.idcIds})
       </if>
    </select>

	<select id="selectEndpointStatisticsInfoByModule" resultType="com.nis.modules.metric.dto.MetricsDto">
		SELECT
            mo.name,
            count( en.id ) as total
        FROM
            module mo
            LEFT JOIN endpoint en ON mo.id = en.module_id
        GROUP BY
            mo.id
	</select>
</mapper>