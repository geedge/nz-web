<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nis.modules.panel.dao.ChartDao">
    
    <resultMap id="chartResult" type="com.nis.modules.panel.entity.Chart">
        <result property="id" column="id"></result>
        <result property="title" column="title"></result>
        <result property="span" column="span"></result>
        <result property="height" column="height"></result>
        <result property="createAt" column="create_at"></result>
        <result property="type" column="type"></result>
        <result property="prev" column="prev"></result>
        <result property="next" column="next"></result>
        <result property="panelId" column="panel_id"></result>
        <result property="param" column="param"></result>
        <result property="unit" column="unit"></result>
        <collection property="elements" ofType="com.nis.modules.panel.entity.ChartElement" columnPrefix="ce_">
            <id property="id" column="id"/>
            <result property="expression" column="expression"></result>
            <result property="type" column="type"></result>
            <result property="legend" column="legend"></result>
        </collection>
    </resultMap>

    <select id="queryCharts" resultMap="chartResult">
        SELECT
            ch.*,
            ce.id AS ce_id,
            ce.expression AS ce_expression,
            ce.type AS ce_type,
            ce.legend AS ce_legend
        FROM chart ch
        LEFT JOIN chart_element ce ON ch.id = ce.chart_id
        WHERE ch.panel_id = #{panelId}

        <if test="chartId != null">
            AND ch.id = #{chartId}
        </if>

        <if test="title != null and title != ''">
            AND ch.title LIKE CONCAT('%', #{title}, '%')
        </if>
    </select>

    <delete id="deleteByIds">
        delete from chart where panel_id=#{panelId} and id in
        <foreach item="id" collection="ids" separator="," open="(" close=")" index="">
            #{id}
        </foreach>
    </delete>

    <update id="updatePrevNextById">
        UPDATE chart
            <set>
                prev = #{chart.prev},
                next = #{chart.next},
                <if test="chart.span != null">
                    span = #{chart.span},
                </if>
                <if test="chart.height != null">
                    height = #{chart.height},
                </if>
            </set>
        WHERE
                id = #{chart.id}
    </update>

    <update id="updatePrevNextBatch">
        <foreach item="chart" collection="charts"  separator=";">
            UPDATE chart
                <set>
                    prev = #{chart.prev},
                    next = #{chart.next},
                    <if test="chart.span != null">
                        span = #{chart.span},
                    </if>
                    <if test="chart.height != null">
                        height = #{chart.height},
                    </if>
                </set>
            WHERE
                id = #{chart.id}
        </foreach>
    </update>
</mapper>