<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nis.modules.panel.dao.ChartDao">
    
    <resultMap id="chartResult" type="com.nis.modules.panel.entity.Chart">
        <result property="id" column="id"></result>
        <result property="title" column="title"></result>
        <result property="span" column="span"></result>
        <result property="height" column="height"></result>
        <result property="createAt" column="create_at"></result>
        <result property="type" column="type"></result>
        <collection property="elements" column="id" select="queryChartElements" ></collection>
    </resultMap>

    <select id="queryCharts" resultMap="chartResult">
        SELECT * FROM chart WHERE panel_id = #{panelId} ORDER BY prev
    </select>

    <select id="queryChartElements" resultType="com.nis.modules.panel.entity.ChartElement">
        select * from chart_element where chart_id=#{id}
    </select>

    <delete id="deleteByIds">
        delete from chart where panel_id=#{panelId} and id in
        <foreach item="id" collection="ids" separator="," open="(" close=")" index="">
            #{id}
        </foreach>
    </delete>
</mapper>