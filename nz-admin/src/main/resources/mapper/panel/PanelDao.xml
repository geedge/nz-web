<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nis.modules.panel.dao.PanelDao">
    
    <resultMap id="panelResult" type="com.nis.modules.panel.entity.Panel">
        <result property="id" column="id"></result>
        <result property="name" column="name"></result>
        <result property="type" column="type"></result>
        <result property="link" column="link"></result>
        <result property="next" column="next"></result>
        <result property="prev" column="prev"></result>
        <result property="buildIn" column="build_in"></result>
        <result property="createBy" column="create_by"></result>
        <result property="pid" column="pid"></result>
        <result property="weight" column="weight"></result>
        <association property="creator" columnPrefix="su_" javaType="com.nis.modules.sys.entity.SysUserEntity">
            <result property="id" column="id" />
            <result property="userName" column="username"></result>
        </association>
    </resultMap>
    
    <select id="queryList" resultMap="panelResult">
        SELECT
        pan.*,
        su.id AS su_userId,
        su.username AS su_username
        FROM
        panel pan
        LEFT JOIN sys_user su ON pan.create_by = su.id
        <where>
            <if test="params.id != null and params.id != ''">
                pan.id = #{params.id}
            </if>

            <if test="params.createBy != null and params.createBy != ''">
                and pan.create_by=#{params.createBy}
            </if>

            <if test="params.type != null and params.type != ''">
                and pan.type=#{params.type}
            </if>

            <if test="params.link != null and params.link != ''">
                and pan.link=#{params.link}
            </if>
        </where>

        /** 按照 weight 排序 */
        ORDER BY pan.weight,pan.id
    </select>


    <select id="queryListByType" resultMap="panelResult">
        SELECT
        pan.*,
        su.id AS su_userId,
        su.username AS su_username
        FROM
        panel pan
        LEFT JOIN sys_user su ON pan.create_by = su.id
        where pan.type = #{type}
    </select>

    <update id="updateWeightBatch">
        <foreach item="panel" collection="panels" separator=";">
            UPDATE panel
            <set>
                weight = #{panel.weight},
                pid = #{panel.pid}
            </set>
            WHERE
            id = #{panel.id}
        </foreach>
    </update>
</mapper>