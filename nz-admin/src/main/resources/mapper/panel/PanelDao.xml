<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nis.modules.panel.dao.PanelDao">
    
    <resultMap id="panelResult" type="com.nis.modules.panel.entity.Panel">
        <result property="id" column="id"></result>
        <result property="name" column="name"></result>
        <result property="createBy" column="create_by"></result>
        <association property="creator" column="create_by" select="querySysUser"></association>
    </resultMap>
    
    <select id="queryPanelsWithPage" resultMap="panelResult">
        select * from panel
        <where>
            <if test="id != null">
                id=#{id}
            </if>
            <if test="name != null and name != ''">
                and name = #{name}
            </if>
            <if test="createBy != null">
                and create_by=#{createBy}
            </if>
        </where>
    </select>

    <select id="querySysUser" resultType="com.nis.modules.sys.entity.SysUserEntity">
        select user_id,username from sys_user where user_id=#{id}
    </select>
</mapper>