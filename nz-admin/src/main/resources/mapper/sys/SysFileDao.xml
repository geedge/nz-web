<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.sys.dao.SysFileDao">

    <resultMap type="com.nis.modules.sys.entity.SysFileEntity" id="sysFileMap">
        <result property="id" column="id"/>
        <result property="uuid" column="uuid"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="size" column="size"/>
        <result property="md5" column="md5"/>
        <result property="meta" column="meta"/>
        <result property="storage" column="storage"/>
        <result property="path" column="path"/>
        <result property="ts" column="ts"/>
    </resultMap>

    <select id="querySysFileList" resultMap="sysFileMap">
        SELECT
            *
        FROM
            sys_file
        <where>
            <if test="params.name != null and params.name != ''">
                AND locate(#{params.name} , name)
            </if>
            <if test="params.uuid != null and params.uuid != ''">
                AND uuid = #{params.uuid}
            </if>
        </where>
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY id
        </if>
    </select>
</mapper>
