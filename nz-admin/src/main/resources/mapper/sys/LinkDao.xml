<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">    
<mapper namespace="com.nis.modules.sys.dao.LinkDao">
	
	<resultMap type="com.nis.modules.sys.entity.Link" id="link">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="createBy" column="create_by"/>
        <result property="url" column="url"/>
        <result property="prev" column="prev"/>
        <result property="next" column="next"/>
        <result property="buildIn" column="build_in"/>
        
        <association columnPrefix="u_" property="creator" javaType="com.nis.modules.sys.entity.SysUserEntity">
	    	<result column="id" property="id"/>
	    	<result column="userName" property="userName"/>
	    </association>
	
    </resultMap>
	
	<select id="queryList" resultMap="link">
       select 
       l.id AS id,
       l.`name` AS name,
       l.create_by AS create_by,
       l.url AS url,
       l.prev AS prev,
       l.next AS next,
       l.build_in AS build_in,
       u.id AS u_userId,
       u.username AS u_userName
       from link l left join sys_user u on l.create_by=u.id
       where 1=1
       <if test="params.id != null and params.id != ''">
           AND l.id = #{params.id}
       </if>
       
       <if test="params.name != null and params.name != ''">
           AND l.name = #{params.name}
       </if>
       
       <if test="params.createBy != null and params.createBy != ''">
           AND l.create_by = #{params.createBy}
       </if>

    </select>

</mapper>