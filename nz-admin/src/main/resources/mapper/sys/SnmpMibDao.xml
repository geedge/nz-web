<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.sys.dao.SnmpMibDao">

    <resultMap type="com.nis.modules.sys.entity.SnmpMib" id="snmpMibWithUser">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="fileName" column="file_name"/>
        <result property="content" column="content"/>
        <result property="models" column="models"/>
        <result property="remark" column="remark"/>
        <result property="updateAt" column="update_at"/>

        <association property="updateUser" javaType="com.nis.modules.sys.entity.SysUserEntity">
            <id property="id" column="id"/>
            <result property="name" column="username"/>
        </association>
    </resultMap>


    <sql id="snmpmib_info_columns">
		sm.id,
		sm.name,
		sm.file_name,
		sm.content,
		sm.models,
		sm.remark,
		sm.update_at,
		su.id,
		su.username
	</sql>

    <select id="queryList" resultMap="snmpMibWithUser">
        SELECT
        <include refid="snmpmib_info_columns"/>
        FROM snmp_mib sm
        LEFT JOIN sys_user su ON sm.update_by = su.id

        WHERE 1=1

        <if test="params.id != null and params.id != ''">
            AND sm.id = #{params.id}
        </if>

        <if test="params.name != null and params.name != ''">
            AND locate(#{params.name} , sm.name )
            OR locate(#{params.name} , sm.file_name)
        </if>
    </select>

    <select id="getMibTreesByIdsAndModels" resultType="com.nis.modules.sys.entity.SnmpMib">
        select sm.id,sm.name,sm.file_name,sm.models,sm.tree from snmp_mib sm
        <where>
            <if test="ids != null and ids.length > 0">
                 sm.id in
                <foreach collection="ids" item="id" index="no" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

    <select id="queryByModelIds" resultType="com.nis.modules.sys.entity.SnmpMib">
        SELECT
            sm.id,
            sm.name,
            sm.models
        FROM
            snmp_mib sm
        <where>
            <if test="ids != null and ids.size > 0">
                <foreach collection="ids" item="id" index="no">
                    OR FIND_IN_SET(#{id}, sm.models)
                </foreach>
            </if>
        </where>
    </select>
</mapper>