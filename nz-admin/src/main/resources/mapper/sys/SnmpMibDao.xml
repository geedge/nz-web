<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.sys.dao.SnmpMibDao">

    <resultMap type="com.nis.modules.sys.entity.SnmpMib" id="snmpMibWithUser">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="fileName" column="file_name"/>
        <result property="content" column="content"/>
        <result property="remark" column="remark"/>
        <result property="updateAt" column="update_at"/>

        <association property="updateUser" javaType="com.nis.modules.sys.entity.SysUserEntity">
            <id property="id" column="user_id"/>
            <result property="name" column="username"/>
        </association>
    </resultMap>


    <sql id="snmpmib_info_columns">
		sm.id,
		sm.name,
		sm.file_name,
		sm.content,
		sm.remark,
		sm.update_at,
		su.user_id,
		su.username
	</sql>

    <select id="queryList" resultMap="snmpMibWithUser">
        SELECT
        <include refid="snmpmib_info_columns"/>
        FROM snmp_mib sm
        LEFT JOIN sys_user su ON sm.update_by = su.user_id

        WHERE 1=1

        <if test="params.id != null and params.id != ''">
            AND sm.id = #{params.id}
        </if>

        <if test="params.name != null and params.name != ''">
            AND sm.name like CONCAT('%', #{params.name}, '%')
        </if>
    </select>
</mapper>