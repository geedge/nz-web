<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.sys.dao.SysUserStarredDao">
    <delete id="removeStarred">
        delete FROM sys_user_starred
        <where>
            <if test="params.ids != null " >
                id in
                    <foreach item="id" collection="params.ids" separator="," open="(" close=")" index="">
                        #{id}
                    </foreach>
            </if>
            <if test="params.type != null and params.type != ''">
                AND type = #{params.type}
            </if>
            <if test="params.tid != null and params.tid != ''">
                AND tid = #{params.tid}
            </if>
        </where>
    </delete>
</mapper>