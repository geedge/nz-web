<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.sys.dao.SysLockDao">


    <select id="selectByKey" resultType="com.nis.modules.sys.entity.SysLock">
        SELECT
            *
        FROM
            `sys_lock`
        WHERE
            `lock_key` = #{key} FOR UPDATE;
    </select>


</mapper>