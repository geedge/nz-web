<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.sys.dao.SysDictDao">

	<select id="queryNodeImgList" resultType="sysDictEntity">
		SELECT code,value
		FROM sys_dict
		<where>
		    del_flag=0 and type='topo-img'
		</where>
	</select>
</mapper>