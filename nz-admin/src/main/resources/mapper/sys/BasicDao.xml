<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nis.modules.sys.dao.BasicMapper">

    <!--执行自定义SQL将返回结果保存到Map中-->
    <select id="selectList" resultType="java.util.Map">
        SELECT id,name FROM ${tableName} WHERE ${col} = #{value}
    </select>

    <select id="queryList" resultType="java.util.Map">
        SELECT *  FROM ${tableName}
        <where>
            <if test="values != null">
                ${col} in
                <foreach item="value" collection="values" separator="," open="(" close=")" index="">
                    #{value}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectKeywordsByTableName" resultType="string">
        SELECT
            t.name
        FROM
            ${params.tableName} t
        <where>
            <if test="params.text != null and params.text != ''">
                locate(#{params.text}, t.name)
            </if>
        </where>
    </select>

</mapper>
