<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.IdcDao">
	<resultMap type="com.nis.modules.asset.entity.Idc" id="idc">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="location" column="location"/>
        <result property="tel" column="tel"/>
        <result property="principal" column="principal"/>
        <result property="seq" column="seq"/>
        <result property="x" column="x"/>
        <result property="y" column="y"/>
        <result property="latitude" column="latitude"/>
        <result property="longitude" column="longitude"/>
        <result property="state" column="state"/>
        <result property="cabinetNum" column="cabinetNum" />
    </resultMap>
    
    <select id="queryPage" resultMap="idc">
       select i.*,
       count(DISTINCT c.id) cabinetNum
       from idc i
       left join cabinet c on i.id=c.dc_id

       <where>
           <if test="params.id != null and params.id != ''">
                i.id = #{params.id}
           </if>

           <if test="params.name != null and params.name != ''">
               AND i.name LIKE CONCAT('%', #{params.name}, '%')
           </if>

           <if test="params.location != null and params.location != ''">
               AND i.location LIKE CONCAT('%', #{params.location}, '%')
           </if>

           <if test="params.tel != null and params.tel != ''">
               AND i.tel LIKE CONCAT('%', #{params.tel}, '%')
           </if>

           <if test="params.principal != null and params.principal != ''">
               AND i.principal = #{params.principal}
           </if>

           <if test="params.state != null and params.state != ''">
               AND i.state = #{params.state}
           </if>
       </where>

	   group by i.id
    </select>
</mapper>
