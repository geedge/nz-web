<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.IdcDao">
	<resultMap type="com.nis.modules.asset.entity.Idc" id="idc">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="location" column="location"/>
        <result property="tel" column="tel"/>
        <result property="principal" column="principal"/>
        <result property="seq" column="seq"/>
        <result property="areaId" column="area_id"/>
        <result property="cabinetNum" column="cabinetNum" />
        <association columnPrefix="sa_" property="area" javaType="com.nis.modules.sys.entity.SysArea">
	    	<id column="id" property="id"/>
	    	<result column="name" property="name"/>
	    	<result column="pid" property="pid"/>
	    	<result column="pids" property="pids"/>
	    	<result column="longitude" property="longitude"/>
	    	<result column="latitude" property="latitude"/>
	    	<result column="i18n" property="i18n"/>
	    </association>
	    
	    <association columnPrefix="as_" property="assetStat" javaType="com.nis.modules.asset.entity.AssetStat">
	    	<result column="total" property="total"/>
	    	<result column="inStock" property="inStock"/>
	    	<result column="outStock" property="outStock"/>
	    	<result column="cabinetNum" property="cabinetNum"/>
	    </association>
	    
    </resultMap>
    
    <select id="queryPage" resultMap="idc">
       select i.*,
       sa.id AS sa_id,
       sa.name AS sa_name,
       sa.pid AS sa_pid,
       sa.pids AS sa_pids,
       sa.longitude AS sa_longitude,
       sa.latitude AS sa_latitude,
       sa.i18n AS sa_i18n,
       count(*) as_total,
	     sum(case a.state when 1 then 1 else 0 end) as_inStock,
       sum(case a.state when 2 then 1 else 0 end) as_outStock,
       count(DISTINCT c.id) cabinetNum
       from idc i left join sys_area sa on i.area_id=sa.id 
       left join asset a on i.id =a.idc_id 
       left join cabinet c on i.id=c.idc_id
       where 1=1
       <if test="params.id != null and params.id != ''">
            AND i.id = #{params.id}
       </if>
       
       <if test="params.name != null and params.name != ''">
           AND i.name = #{params.name}
       </if>
       
       <if test="params.location != null and params.location != ''">
           AND i.location = #{params.location}
       </if>
		
	   <if test="params.tel != null and params.tel != ''">
           AND i.tel = #{params.tel}
       </if>
       
       <if test="params.principal != null and params.principal != ''">
           AND i.principal = #{params.principal}
       </if>
		
	   group by i.id
    </select>
</mapper>