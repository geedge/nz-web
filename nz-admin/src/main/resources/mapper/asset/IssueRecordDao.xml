<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.IssueRecordDao">

    <resultMap type="com.nis.modules.asset.entity.IssueRecord" id="issueMap">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="content" column="content"/>
        <result property="state" column="state"/>
        <result property="priority" column="priority"/>
        <result property="cts" column="cts"/>
        <result property="uts" column="uts"/>
        <result property="cid" column="cid"/>
        <result property="uid" column="uid"/>
        <result property="rid" column="rid"/>
        <result property="aid" column="aid"/>
        <result property="starred" column="starred"/>
        <collection property="assets" column="id" ofType="com.nis.modules.asset.entity.AssetAsset" select="queryAssetList" >
            <result property="id" column="id"/>
            <result property="name" column="name"/>
        </collection>
    </resultMap>

    <select id="queryIssueList" resultMap="issueMap">
        SELECT
            issue.*,
            IFNULL( sus.starred, 0 ) AS starred
        FROM
            issue_record issue
            LEFT JOIN issue_asset_rel rel ON issue.id = rel.issue_id
            LEFT JOIN asset_asset asset ON rel.asset_id = asset.id
            LEFT JOIN ( SELECT IF(COUNT(1) > 0, 1, 0) AS starred,tid FROM sys_user_starred WHERE type = "issueRecord" AND uid = #{params.userId} GROUP BY tid) sus ON issue.id = sus.tid
        <where>

            <if test="params.ids != null">
                issue.id in
                <foreach item="id" collection="params.ids" separator="," open="(" close=")" index="">
                    #{id}
                </foreach>
            </if>

            <if test="params.name != null and params.name != ''">
                AND locate(#{params.name} , issue.name)
            </if>

            <if test="params.type != null and params.type != ''">
                AND issue.type = #{params.type}
            </if>

            <if test="params.state != null and params.state != ''">
                AND issue.state = #{params.state}
            </if>

            <if test="params.priority != null and params.priority != ''">
                AND issue.priority = #{params.priority}
            </if>

            <if test="params.assetId != null and params.assetId != ''">
                AND asset.id = #{params.assetId}
            </if>

            <if test="params.assetName != null and params.assetName != ''">
                AND locate(#{params.assetName} , asset.name)
            </if>

            <if test="params.cid != null and params.cid != ''">
                AND issue.cid = #{params.cid}
            </if>

            <if test="params.uid != null and params.uid != ''">
                AND issue.uid = #{params.uid}
            </if>

            <if test="params.rid != null and params.rid != ''">
                AND issue.rid = #{params.rid}
            </if>

            <if test="params.aid != null and params.aid != ''">
                AND issue.aid = #{params.aid}
            </if>

            <if test="params.starred != null and params.starred != ''">
                AND
                <if test=' params.starred eq 1 '>
                    sus.starred = #{params.starred}
                </if>
                <if test=' params.starred eq 0 '>
                    sus.starred IS NULL
                </if>
            </if>

        </where>
        GROUP BY issue.id
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY issue.id
        </if>
    </select>
    <select id="queryAssetList" resultType="com.nis.modules.asset.entity.AssetAsset">
        SELECT
            asset.id,
            asset.name
        FROM
            asset_asset asset
            LEFT JOIN issue_asset_rel rel ON rel.asset_id = asset.id
        WHERE
            rel.issue_id = #{id}
    </select>

</mapper>
