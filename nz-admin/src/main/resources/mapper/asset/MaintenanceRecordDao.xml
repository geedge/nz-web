<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.MaintenanceRecordDao">

    <resultMap type="com.nis.modules.asset.entity.MaintenanceRecord" id="maintenanceWithAssetUser">
        <result property="id" column="id"/>
        <result property="content" column="content"/>
        <result property="createAt" column="create_at"/>
        <result property="updateAt" column="update_at"/>

        <!--资产-->
        <result property="asset.id" column="assetId"/>
        <result property="asset.host" column="assetHost"/>
        <result property="asset.sn" column="assetSn"/>

        <!--用户-->
        <result property="createByUser.userId" column="su_user_id"/>
        <result property="createByUser.username" column="su_username"/>
        <result property="createByUser.password" column="su_password"/>
        <result property="createByUser.salt" column="su_salt"/>
        <result property="createByUser.email" column="su_email"/>
        <result property="createByUser.status" column="su_status"/>
        <result property="createByUser.createTime" column="su_createTime"/>


        <result property="updateByUser.userId" column="su1_user_id"/>
        <result property="updateByUser.username" column="su1_username"/>
        <result property="updateByUser.password" column="su1_password"/>
        <result property="updateByUser.salt" column="su1_salt"/>
        <result property="updateByUser.email" column="su1_email"/>
        <result property="updateByUser.status" column="su1_status"/>
        <result property="updateByUser.createTime" column="su1_createTime"/>
    </resultMap>


    <sql id="maintenance_info_columns">
            mr.id,
            mr.content,
            mr.create_at,
            mr.update_at,

            /*资产*/
            ass.id AS assetId,
            ass.host AS assetHost,
            ass.sn AS assetSn,

            /*用户*/
           su.user_id AS su_user_id,
           su.username AS su_username,
           su.password AS su_password,
           su.salt AS su_salt,
           su.email AS su_email,
           su.status AS su_status,
           su.create_time AS su_createTime,

           su1.user_id AS su1_user_id,
           su1.username AS su1_username,
           su1.password AS su1_password,
           su1.salt AS su1_salt,
           su1.email AS su1_email,
           su1.status AS su1_status,
           su1.create_time AS su1_createTime

    </sql>

    <select id="queryList" resultMap="maintenanceWithAssetUser">
        SELECT
        <include refid="maintenance_info_columns"/>
        FROM maintenance_record mr

        LEFT JOIN asset ass ON mr.asset_id = ass.id
        LEFT JOIN sys_user su ON mr.create_by = su.user_id
        LEFT JOIN sys_user su1 ON mr.update_by = su1.user_id

        <where>
            <if test="params.id != null and params.id != ''">
                mr.id = #{params.id}
            </if>

            <if test="params.assetId != null and params.assetId != ''">
                AND mr.asset_id = #{params.assetId}
            </if>

            <if test="params.content != null and params.content != ''">
                AND mr.content like CONCAT('%', #{params.content}, '%')
            </if>
        </where>
    </select>
</mapper>