<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.ModelDao">
    <resultMap type="com.nis.modules.asset.entity.Model" id="modelWithVendorAndType">

        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="remark" column="remark"/>

        <!--厂商-->
        <result property="vendor.id" column="vendorId"/>
        <result property="vendor.value" column="vendorValue"/>
        <result property="vendor.code" column="vendorCode"/>
        <result property="vendor.type" column="vendorType"/>

        <!--类型-->
        <result property="type.id" column="assetId"/>
        <result property="type.value" column="assetValue"/>
        <result property="type.code" column="assetCode"/>
        <result property="type.type" column="assetType"/>

        <association columnPrefix="as_" property="assetStat" javaType="com.nis.modules.overview.entity.AssetStat">
            <result column="total" property="total"/>
            <result column="inStock" property="inStock"/>
            <result column="outStock" property="outStock"/>
        </association>
    </resultMap>
    <resultMap id="modelWithMib" type="com.nis.modules.asset.entity.ModelWithMib">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="vendor" column="vendor"/>
        <result property="type"   column="type"/>
    </resultMap>





    <sql id="model_info_columns">
          mo.id,
          mo.name,
          mo.remark,

          /*厂商*/
          dict.id AS vendorId,
          dict.value AS vendorValue,
          dict.code AS vendorCode,
          dict.type AS vendorType,

          /*资产类型*/
          dict1.id AS assetId,
          dict1.value AS assetValue,
          dict1.code AS assetCode,
          dict1.type AS assetType,

          /*资产统计*/
          COUNT(ass.id) as as_total,
          SUM(CASE ass.state WHEN 1 THEN 1 ELSE 0 END) AS as_inStock,
          SUM(CASE ass.state WHEN 2 THEN 1 ELSE 0 END) AS as_outStock
    </sql>

    <select id="queryList" resultMap="modelWithVendorAndType">
        SELECT
        <include refid="model_info_columns"/>
        FROM model mo

         JOIN sys_dict dict ON dict.code = mo.vendor AND dict.type = 'vendor' AND dict.del_flag = 0
         JOIN sys_dict dict1 ON dict1.code = mo.type AND dict1.type = 'assetType' AND dict1.del_flag = 0
        LEFT JOIN asset ass ON mo.id = ass.model_id

        <where>
            <if test="params.id != null and params.id != ''">
                mo.id = #{params.id}
            </if>

            <if test="params.name != null and params.name != ''">
                AND mo.name like CONCAT('%', #{params.name}, '%')
            </if>

            <if test="params.vendorCode != null and params.vendorCode != ''">
                AND mo.vendor = #{params.vendorCode}
            </if>

            <if test="params.typeCode != null and params.typeCode != ''">
                AND mo.type = #{params.typeCode}
            </if>

            <if test="params.remark != null and params.remark != ''">
                AND mo.remark like CONCAT('%', #{params.remark}, '%')
            </if>
        </where>

        GROUP BY mo.id
    </select>

    <select id="selectByModels" resultMap="modelWithMib">
    SELECT
	m.id id,m.name name, sd.value vendor,sd1.value type
    FROM
	model m INNER JOIN sys_dict sd on m.vendor = sd.code AND sd.type='vendor'AND sd.del_flag=0
            INNER JOIN  sys_dict sd1 ON m.type  =sd1.code AND sd1.type='assetType' AND sd1.del_flag=0
    WHERE m.id
        <if test="models != null and models.length > 0">
            AND m.id IN
            <foreach collection="models" item="id" index="no" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </select>
</mapper>