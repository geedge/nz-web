<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.AssetPingDao">
    
    <delete id="deleteAll">
        truncate asset_ping
    </delete>

    <select id="getAssetStatGroupByStatus" resultType="map">
        SELECT
            count( 1 ) AS total,
        status
        FROM
            asset_ping
        GROUP BY
        status
    </select>
</mapper>