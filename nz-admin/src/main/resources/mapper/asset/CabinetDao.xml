<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.CabinetDao">

    <resultMap id="cabinetWithAssets" type="com.nis.modules.asset.entity.Cabinet">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="uSize" column="u_size"/>
        <result property="dcId" column="dc_id"/>

        <collection property="assetList" ofType="com.nis.modules.asset.entity.Asset" columnPrefix="as_">
            <result column="id" property="id"/>
            <result column="cabinetId" property="cabinetId"/>
            <result column="cabinetStart" property="cabinetStart"/>
            <result column="cabinetEnd" property="cabinetEnd"/>
        </collection>
    </resultMap>

    <resultMap id="cabinetWithAssetPosition" type="com.nis.modules.asset.entity.Cabinet">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="uSize" column="u_size"/>
        <result property="dcId" column="dc_id"/>

        <collection property="assets" ofType="com.nis.modules.asset.entity.AssetAsset" columnPrefix="as_">
            <result column="id" property="id"/>
            <result column="cabinetId" property="cabinetId"/>
            <result column="cabinetStart" property="cabinetStart"/>
            <result column="cabinetEnd" property="cabinetEnd"/>
        </collection>
    </resultMap>

    <select id="queryPage" resultType="com.nis.modules.asset.entity.Cabinet">
        SELECT
            cab.id,
            cab.name,
            cab.dc_id,
            cab.u_size,
            cab.remark,
            cab.x,
            cab.y
        FROM
            cabinet cab
        <where>
            <if test="params.id != null and params.id != ''">
                cab.id = #{params.id}
            </if>

            <if test="params.name != null and params.name != ''">
                AND cab.name LIKE CONCAT('%', #{params.name}, '%')
            </if>

            <if test="params.dcId != null and params.dcId != ''">
                AND cab.dc_id = #{params.dcId}
            </if>

            <if test="params.uSize != null and params.uSize != ''">
                AND cab.u_size = #{params.uSize}
            </if>

            <if test="params.remark != null and params.remark != ''">
                AND cab.remark LIKE CONCAT('%', #{params.remark}, '%')
            </if>

            <if test="params.x != null and params.x != ''">
                AND cab.x = #{params.x}
            </if>

            <if test="params.y != null and params.y != ''">
                AND cab.y = #{params.y}
            </if>
        </where>
    </select>

    <select id="getCabinetMaxXY" resultType="java.util.Map">
        SELECT
            max( cab.y ) AS y,
            max( cab.x ) AS x
        FROM
            cabinet cab
        WHERE
            cab.dc_id = #{id}
    </select>

    <select id="getCabinetWithAssets" resultMap="cabinetWithAssets">
        SELECT
	        cab.id,cab.name,cab.u_size,cab.dc_id,ass.id AS as_id,ass.cabinet_id AS as_cabinetId,ass.cabinet_start AS as_cabinetStart,ass.cabinet_end AS as_cabinetEnd
        FROM
            cabinet cab
            LEFT JOIN asset ass ON cab.id = ass.cabinet_id
    </select>

    <select id="getCabinetWithAssetPositionInfo" resultMap="cabinetWithAssetPosition">
        SELECT
	        cab.id,cab.name,cab.u_size,cab.dc_id,ass.id AS as_id,ass.cabinet_id AS as_cabinetId,ass.cabinet_start AS as_cabinetStart,ass.cabinet_end AS as_cabinetEnd
        FROM
            cabinet cab
            LEFT JOIN asset_asset ass ON cab.id = ass.cabinet_id
    </select>
</mapper>
