<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.CabinetDao">
    <resultMap type="com.nis.modules.asset.entity.Cabinet" id="cabinetWithAssetStat">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="idcId" column="idcId"/>
        <result property="uSize" column="uSize"/>
        <result property="remark" column="remark"/>

        <association columnPrefix="as_" property="assetStat" javaType="com.nis.modules.asset.entity.AssetStat">
            <result column="total" property="total"/>
            <result column="inStock" property="inStock"/>
            <result column="outStock" property="outStock"/>
        </association>

    </resultMap>

    <select id="queryPage" resultMap="cabinetWithAssetStat">
        SELECT cab.id,cab.name,cab.idc_id AS idcId,cab.u_size AS uSize,cab.remark,COUNT(ass.id) as_total,
			SUM(CASE ass.state WHEN 1 THEN 1 ELSE 0 END) as_inStock,
            SUM(CASE ass.state WHEN 2 THEN 1 ELSE 0 END) as_outStock
        FROM cabinet cab
        LEFT JOIN asset ass ON cab.id = ass.cabinet_id

        WHERE 1=1
        <if test="params.id != null and params.id != ''">
            AND cab.id = #{params.id}
        </if>

        <if test="params.name != null and params.name != ''">
            AND cab.name LIKE CONCAT('%', #{params.name}, '%')
        </if>

        <if test="params.idcId != null and params.idcId != ''">
            AND cab.idc_id = #{params.idcId}
        </if>

        <if test="params.uSize != null and params.uSize != ''">
            AND cab.u_size = #{params.uSize}
        </if>

        <if test="params.remark != null and params.remark != ''">
            AND cab.remark LIKE CONCAT('%', #{params.remark}, '%')
        </if>

        GROUP BY cab.id
    </select>
</mapper>