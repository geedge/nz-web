<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.CabinetDao">

    <resultMap id="cabinetWithAssetPosition" type="com.nis.modules.asset.entity.Cabinet">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="uSize" column="u_size"/>
        <result property="dcId" column="dc_id"/>

        <collection property="assets" ofType="com.nis.modules.asset.entity.AssetAsset" columnPrefix="as_">
            <result column="id" property="id"/>
            <result column="cabinetId" property="cabinetId"/>
            <result column="cabinetStart" property="cabinetStart"/>
            <result column="cabinetEnd" property="cabinetEnd"/>
        </collection>
    </resultMap>



    <resultMap id="cabinetDeatil" type="com.nis.modules.asset.entity.Cabinet">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="uSize" column="u_size"/>
        <result property="y" column="y"/>
        <result property="x" column="x"/>
        <result property="remark" column="remark"/>
        <result property="assetNum" column="assetNum"/>
        <result property="alertNum" column="alertNum"/>

        <result property="dc.id" column="dc_id"/>
        <result property="dc.name" column="dc_name"/>

    </resultMap>

    <select id="queryPage" resultMap="cabinetDeatil">
        SELECT
            cab.*,
            dc.name as dc_name,
            IFNULL(asset.assetNum,0) AS assetNum,
            IFNULL(msg.alertNum,0) AS alertNum
        FROM
            cabinet cab
        LEFT JOIN dc ON dc.id = cab.dc_id
        LEFT JOIN (select cabinet_id,count(1) as assetNum from asset_asset group by cabinet_id) asset ON asset.cabinet_id = cab.id
        LEFT JOIN (select cabinet_id,count(1) as alertNum  from alert_message_active ama left join asset_asset aa on ama.asset_id = aa.id where ama.asset_id is not null group by aa.cabinet_id) msg ON msg.cabinet_id = cab.id
        <where>
            <if test="params.ids != null">
                cab.id in
                <foreach item="id" collection="params.ids" separator="," open="(" close=")" index="">
                    #{id}
                </foreach>
            </if>

            <if test="params.dcIds != null">
                AND cab.dc_id in
                <foreach item="id" collection="params.dcIds" separator="," open="(" close=")" index="">
                    #{id}
                </foreach>
            </if>

            <if test="params.name != null and params.name != ''">
                AND cab.name LIKE CONCAT('%', #{params.name}, '%')
            </if>
        </where>
    </select>

    <select id="getCabinetMaxXY" resultType="java.util.Map">
        SELECT
            max( cab.y ) AS y,
            max( cab.x ) AS x
        FROM
            cabinet cab
        WHERE
            cab.dc_id = #{id}
    </select>

    <select id="getCabinetWithAssetPositionInfo" resultMap="cabinetWithAssetPosition">
        SELECT
	        cab.id,cab.name,cab.u_size,cab.dc_id,ass.id AS as_id,ass.cabinet_id AS as_cabinetId,ass.cabinet_start AS as_cabinetStart,ass.cabinet_end AS as_cabinetEnd
        FROM
            cabinet cab
            LEFT JOIN asset_asset ass ON cab.id = ass.cabinet_id
    </select>
</mapper>
