<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.IdcTrafficDao">

    <resultMap type="com.nis.modules.asset.entity.IdcTraffic" id="traffic">
        <result property="id" column="id"/>
        <result property="direction" column="direction"/>
        <result property="ifindex" column="ifindex"/>
        <result property="ifdescr" column="ifdescr"/>
        <result property="tags" column="tags"/>
        <result property="host" column="host"/>
        <result property="port" column="port"/>
        <result property="version" column="version"/>
        <result property="community" column="community"/>
        <result property="auth" column="auth"/>

        <association columnPrefix="idc_" property="idc" javaType="com.nis.modules.asset.entity.Idc">
            <result property="id" column="id"/>
            <result property="name" column="name"/>
            <result property="location" column="location"/>
            <result property="tel" column="tel"/>
            <result property="principal" column="principal"/>
            <result property="seq" column="seq"/>
            <result property="x" column="x"/>
            <result property="y" column="y"/>
        </association>
    </resultMap>

    <sql id="traffic_info_columns">
        tra.id,
        tra.direction,
        tra.ifindex,
        tra.ifdescr,
        tra.tags,
        tra.host,
        tra.port,
        tra.version,
        tra.community,
        tra.auth,

        idc.id AS idc_id,
        idc.NAME AS idc_name,
        idc.location AS idc_location,
        idc.tel AS idc_tel,
        idc.principal AS idc_principal,
        idc.seq AS idc_seq,
        idc.x AS idc_x,
        idc.y AS idc_y
    </sql>


    <select id="queryTrafficSetting" resultMap="traffic">
        SELECT
        <include refid="traffic_info_columns"></include>
        FROM
        idc_traffic tra
        LEFT JOIN idc idc ON tra.idc_id = idc.id

        <where>
            <if test="params.id != null and params.id != ''">
                tra.idc_id = #{params.id}
            </if>

            <if test="params.direction != null and params.direction != ''">
                and tra.direction like CONCAT('%', #{params.direction}, '%')
            </if>
        </where>
    </select>

</mapper>