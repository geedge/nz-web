    <resultMap type="com.nis.modules.panel.entity.VisualChart" id="chartIdWithAssetEntity">
        <id property="id" column="chartId"/>

        <association property="asset" javaType="com.nis.modules.asset.entity.AssetAsset">
            <result property="id" column="id"/>
            <result property="name" column="name"/>
            <result property="sn" column="sn"/>
            <result property="number" column="number"/>
            <result property="manageIp" column="manage_ip"/>
        </association>
    </resultMap>

    <select id="queryAssetList" resultMap="assetMap">
		SELECT
			asset.*,
			type.id AS t_id,
			type.NAME AS t_name,
			type.vm AS t_vm,
			type.vmh AS t_vmh,
			state.id AS s_id,
			state.NAME AS s_name,
			brand.id AS b_id,
			brand.NAME AS b_name,
			dc.id AS d_id,
			dc.NAME AS d_name,
			cab.id AS c_id,
			cab.NAME AS c_name,
			model.id AS m_id,
			model.NAME AS m_name,
            model.tsg_appliance AS m_tsg_appliance,
			assp.STATUS AS assp_status,
			talon.STATUS AS talon_status,
			IFNULL( me.endpointNum, 0 ) AS endpointNum,
			IFNULL( msg.alertNum, 0 ) AS alertNum ,
            IFNULL( sus.starred, 0 ) AS starred
		FROM
			asset_asset asset
			LEFT JOIN asset_state_conf state ON asset.state_id = state.id
			LEFT JOIN asset_type_conf type ON asset.type_id = type.id
			LEFT JOIN asset_brand brand ON asset.brand_id = brand.id
			LEFT JOIN asset_model model ON asset.model_id = model.id
			LEFT JOIN dc dc ON asset.dc_id = dc.id
			LEFT JOIN cabinet cab ON asset.cabinet_id = cab.id
			LEFT JOIN asset_ping assp ON asset.id = assp.asset_id
			LEFT JOIN asset_talon_status talon ON asset.id = talon.asset_id
			LEFT JOIN ( SELECT asset_id, count( 1 ) AS endpointNum, GROUP_CONCAT(DISTINCT module_id ) module_ids FROM monitor_endpoint GROUP BY asset_id ) me ON asset.id = me.asset_id
			LEFT JOIN ( SELECT asset_id, count( 1 ) AS alertNum FROM alert_message_active WHERE asset_id IS NOT NULL GROUP BY asset_id ) msg ON asset.id = msg.asset_id
            LEFT JOIN ( SELECT IF(COUNT(1) > 0, 1, 0) AS starred,tid FROM sys_user_starred WHERE type = "asset" AND uid = #{params.userId} GROUP BY tid) sus ON asset.id = sus.tid
        <where>

             <if test="params.ids != null">
                 asset.id in 
					<foreach item="id" collection="params.ids" separator="," open="(" close=")" index="">
			       		#{id}
				     </foreach>
             </if>

             <if test="params.sn != null and params.sn != ''">
                 AND locate(#{params.sn} , asset.sn)
             </if>

             <if test="params.name != null and params.name != ''">
                 AND locate(#{params.name} , asset.name)
             </if>

             <if test="params.manageIp != null and params.manageIp != ''">
                 AND locate(#{params.manageIp} , asset.manage_ip)
             </if>

             <if test="params.ipmiIp != null and params.ipmiIp != ''">
                 AND locate(#{params.ipmiIp} , asset.ipmi_ip)
             </if>

             <if test="params.brandIds != null and params.brandIds.size > 0">
                 AND asset.brand_id IN
                 <foreach collection="params.brandIds" item="brandId" index="no" open="(" separator="," close=")">
                     #{brandId}
                 </foreach>
             </if>

             <if test="params.modelIds != null and params.modelIds.size > 0">
                 AND asset.model_id IN
                 <foreach collection="params.modelIds" item="modelId" index="no" open="(" separator="," close=")">
                     #{modelId}
                 </foreach>
             </if>

             <if test="params.dcIds != null and params.dcIds.size > 0">
                 AND asset.dc_id IN
                 <foreach collection="params.dcIds" item="dcId" index="no" open="(" separator="," close=")">
                     #{dcId}
                 </foreach>
             </if>

             <if test="params.cabinetIds != null and params.cabinetIds.size > 0">
                 AND asset.cabinet_id IN
                 <foreach collection="params.cabinetIds" item="cabId" index="no" open="(" separator="," close=")">
                     #{cabId}
                 </foreach>
             </if>

             <if test="params.typeIds != null and params.typeIds.size > 0">
                 AND asset.type_id IN
                 <foreach collection="params.typeIds" item="typeId" index="no" open="(" separator="," close=")">
                     #{typeId}
                 </foreach>
             </if>

             <if test="params.stateIds != null and params.stateIds.size > 0">
                 AND asset.state_id IN
                 <foreach collection="params.stateIds" item="stateId" index="no" open="(" separator="," close=")">
                     #{stateId}
                 </foreach>
             </if>

            <if test="params.moduleIds != null and params.moduleIds.size > 0">
                AND
                <foreach collection="params.moduleIds" item="moduleId" index="no" open="(" separator=" OR " close=")">
                	FIND_IN_SET(#{moduleId},me.module_ids )
                </foreach>
            </if>

            <if test="params.innerModuleIdsByPorjects != null and params.innerModuleIdsByPorjects.size > 0">
                AND
                <foreach collection="params.innerModuleIdsByPorjects" item="moduleId" index="no" open="(" separator=" OR " close=")">
                    FIND_IN_SET(#{moduleId},me.module_ids )
                </foreach>
            </if>

             <if test="params.innerAssetIdsByFields != null and params.innerAssetIdsByFields.size > 0">
                 AND asset.id IN
                 <foreach collection="params.innerAssetIdsByFields" item="tmplId" index="no" open="(" separator="," close=")">
                     #{tmplId}
                 </foreach>
             </if>

            <if test="params.ping != null and params.ping.size > 0">
                AND assp.status IN
                 <foreach collection="params.ping" item="ps" index="no" open="(" separator="," close=")">
                     #{ps}
                 </foreach>
            </if>
            
            <if test="params.pids != null and params.pids.size > 0">
                AND asset.pid IN
                 <foreach collection="params.pids" item="pid" index="no" open="(" separator="," close=")">
                     #{pid}
                 </foreach>
            </if>
            
            <if test="params.authProtocol != null">
                AND type.auth_protocol = #{params.authProtocol}
            </if>

            <if test="params.vmh != null and params.vmh != ''">
                AND type.vmh = #{params.vmh}
            </if>

            <if test="params.vm != null and params.vm != ''">
                AND type.vm = #{params.vm}
            </if>

            <if test="params.starred != null and params.starred != ''">
                AND
                <if test=' params.starred eq 1 '>
                    sus.starred = #{params.starred}
                </if>
                <if test=' params.starred eq 0 '>
                    sus.starred IS NULL
                </if>
            </if>

            <if test="params.innerAssetIdsByComment != null and params.innerAssetIdsByComment.size > 0">
                AND asset.id IN
                <foreach collection="params.innerAssetIdsByComment" item="tmplId" index="no" open="(" separator="," close=")">
                    #{tmplId}
                </foreach>
            </if>
            <if test="params.snmpEnable != null and params.snmpEnable != ''">
                AND type.snmp_enable = #{params.snmpEnable}
            </if>

         </where>
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY asset.id
        </if>
    </select>
    
    <select id="queryAssetGroupBy" resultType="java.util.Map">
		SELECT
			${column} AS id,
			<if test="column == 'fvm.meta_id'">
				fvm.name AS name,
				fvm.val AS option,
			</if>
			count(DISTINCT asset.id) AS num 
		FROM
			asset_asset asset
			LEFT JOIN asset_ping assp ON asset.id = assp.asset_id
			LEFT JOIN asset_field_value fv ON asset.id = fv.asset_id
			LEFT JOIN (select fv.meta_id,fv.`value` as val,fm.name, fv.asset_id from asset_field_value fv LEFT JOIN asset_field_meta fm on fv.meta_id = fm.id where fm.search = 1 AND fv.value != '' GROUP BY fv.meta_id,fv.`value`,fv.asset_id ) fvm ON asset.id = fvm.asset_id
        <where>
             <if test="params.ids != null">
                 asset.id in
					<foreach item="id" collection="params.ids" separator="," open="(" close=")" index="">
			       		#{id}
				     </foreach>
             </if>
             <if test="params.sn != null and params.sn != ''">
                 AND locate(#{params.sn} , asset.sn)
             </if>
             <if test="params.name != null and params.name != ''">
                 AND locate(#{params.name} , asset.name)
             </if>
             <if test="params.manageIp != null and params.manageIp != ''">
                 AND locate(#{params.manageIp} , asset.manage_ip)
             </if>
             <if test="params.ipmiIp != null and params.ipmiIp != ''">
                 AND locate(#{params.ipmiIp} , asset.ipmi_ip)
             </if>
             <if test="params.brandIds != null and params.brandIds.size > 0">
                 AND asset.brand_id IN
                 <foreach collection="params.brandIds" item="brandId" index="no" open="(" separator="," close=")">
                     #{brandId}
                 </foreach>
             </if>
             <if test="params.modelIds != null and params.modelIds.size > 0">
                 AND asset.model_id IN
                 <foreach collection="params.modelIds" item="modelId" index="no" open="(" separator="," close=")">
                     #{modelId}
                 </foreach>
             </if>
             <if test="params.dcIds != null and params.dcIds.size > 0">
                 AND asset.dc_id IN
                 <foreach collection="params.dcIds" item="dcId" index="no" open="(" separator="," close=")">
                     #{dcId}
                 </foreach>
             </if>
             <if test="params.cabinetIds != null and params.cabinetIds.size > 0">
                 AND asset.cabinet_id IN
                 <foreach collection="params.cabinetIds" item="cabId" index="no" open="(" separator="," close=")">
                     #{cabId}
                 </foreach>
             </if>
             <if test="params.typeIds != null and params.typeIds.size > 0">
                 AND asset.type_id IN
                 <foreach collection="params.typeIds" item="typeId" index="no" open="(" separator="," close=")">
                     #{typeId}
                 </foreach>
             </if>
             <if test="params.stateIds != null and params.stateIds.size > 0">
                 AND asset.state_id IN
                 <foreach collection="params.stateIds" item="stateId" index="no" open="(" separator="," close=")">
                     #{stateId}
                 </foreach>
             </if>
            <if test="params.moduleIds != null and params.moduleIds.size > 0">
                AND
                <foreach collection="params.moduleIds" item="moduleId" index="no" open="(" separator=" OR " close=")">
                	FIND_IN_SET(#{moduleId},me.module_ids )
                </foreach>
            </if>
            <if test="params.innerModuleIdsByPorjects != null and params.innerModuleIdsByPorjects.size > 0">
                AND
                <foreach collection="params.innerModuleIdsByPorjects" item="moduleId" index="no" open="(" separator=" OR " close=")">
                    FIND_IN_SET(#{moduleId},me.module_ids )
                </foreach>
            </if>
            <if test="params.innerAssetIdsByFields != null and params.innerAssetIdsByFields.size > 0">
                AND asset.id IN
                <foreach collection="params.innerAssetIdsByFields" item="tmplId" index="no" open="(" separator="," close=")">
                    #{tmplId}
                </foreach>
            </if>

            <if test="params.ping != null and params.ping.size > 0">
                AND assp.status IN
                 <foreach collection="params.ping" item="ps" index="no" open="(" separator="," close=")">
                     #{ps}
                 </foreach>
            </if>
            
            <if test="params.pids != null and params.pids.size > 0">
                AND asset.pid IN
                 <foreach collection="params.pids" item="pid" index="no" open="(" separator="," close=")">
                     #{pid}
                 </foreach>
            </if>
            
            <if test="params.authProtocol != null">
                AND type.auth_protocol = #{params.authProtocol}
            </if>

            <if test="params.vmh != null and params.vmh != ''">
                AND type.vmh = #{params.vmh}
            </if>

            <if test="params.vm != null and params.vm != ''">
                AND type.vm = #{params.vm}
            </if>
         </where>
         GROUP BY  
         <if test="column != 'fvm.meta_id'">
         	${column}
         </if>
         
         <if test="column == 'fvm.meta_id'">
			fvm.meta_id,fvm.val
		 </if>
    </select>
    <update id="updateAssetStateBatch">
    	update asset_asset
    	<set>
	    	<if test="params.stateId != null">
	    		state_id = #{params.stateId},
	    	</if>
	    	<if test="params.snmpCredentialId != null">
	    		snmp_credential_id = #{params.snmpCredentialId},
	    	</if>
	    	<if test="params.authType != null">
	    		auth_type = #{params.authType},
	    	</if>
	    	<if test="params.authProtocolPort != null">
	    		auth_protocol_port = #{params.authProtocolPort},
	    	</if>
	    	<if test="params.authUsername != null and params.authUsername !='' ">
	    		auth_username = #{params.authUsername},
	    	</if>
	    	<if test="params.authPin != null and params.authPin !='' ">
	    		auth_pin = #{params.authPin},
	    	</if>
	    	<if test="params.authPriKey != null and params.authPriKey !='' ">
	    		auth_pri_key = #{params.authPriKey},
	    	</if>
	    	<if test="params.authUserTip != null and params.authUserTip !='' ">
	    		auth_user_tip = #{params.authUserTip},
	    	</if>
	    	<if test="params.authPinTip != null and params.authPinTip !='' ">
	    		auth_pin_tip = #{params.authPinTip},
	    	</if>
    	</set>
    	where id in
    	<foreach item="id" collection="ids" separator="," open="(" close=")" index="">
       		#{id}
	    </foreach>
    </update>

    <select id="getTsgAssetListbyModel" resultType="com.nis.modules.asset.entity.AssetAsset">
        SELECT
            ass.*
        FROM
            asset_asset ass
            LEFT JOIN asset_model model ON ass.model_id = model.id
        WHERE
            model.tsg_appliance = 1
    </select>
</mapper>
