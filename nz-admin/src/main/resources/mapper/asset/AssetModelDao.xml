<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.AssetModelDao">

    <resultMap type="com.nis.modules.asset.entity.AssetModel" id="modelWithBrandMap">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="brandId" column="brand_id"/>
        <result property="remark" column="remark"/>
        <result property="seq" column="seq"/>
        <result property="typeId" column="type_id"/>
        <result property="sysObjectId" column="sys_object_id"/>
        <result property="chartIds" column="chart_ids"/>
        <result property="dashboardId" column="dashboard_id"/>
        <result property="assetNum" column="assetNum"/>
        <result property="starred" column="starred"/>
        <result property="tsgAppliance" column="tsg_appliance"/>

        <association property="brand" columnPrefix="b_" javaType="com.nis.modules.asset.entity.AssetBrand">
            <id property="id" column="id"/>
            <result property="name" column="name"/>
        </association>

        <association property="type" columnPrefix="atc_" javaType="com.nis.modules.asset.entity.AssetTypeConf">
            <id property="id" column="id"/>
            <result property="name" column="name"/>
        </association>
    </resultMap>

    <select id="queryList" resultMap="modelWithBrandMap">
		SELECT
			model.*,
			brand.id AS b_id,
			brand.NAME AS b_name,
            atc.id AS atc_id,
            atc.NAME AS atc_name,
			IFNULL( asset.assetNum, 0 ) AS assetNum ,
            IFNULL( sta.starred, 0 ) AS starred
		FROM
			asset_model model
			LEFT JOIN asset_brand brand ON model.brand_id = brand.id
            LEFT JOIN asset_type_conf atc on model.type_id = atc.id
			LEFT JOIN ( SELECT model_id, count( 1 ) AS assetNum FROM asset_asset GROUP BY model_id ) asset ON model.id = asset.model_id
            LEFT JOIN ( SELECT IF(COUNT(1) > 0, 1, 0) AS starred,tid FROM sys_user_starred WHERE TYPE = "assetModel" AND uid = #{params.userId} GROUP BY tid) sta ON model.id = sta.tid
        <where>
            <if test="params.name != null and params.name != ''">
                and locate(#{params.name} , model.name)
            </if>
            <if test="params.brandIds != null">
            	and model.brand_id in 
            	<foreach item="brandId" collection="params.brandIds" separator="," open="(" close=")" index="">
		       		#{brandId}
			    </foreach>
            </if>

            <if test="params.typeIds != null ">
                and model.type_id in
                <foreach item="typeId" collection="params.typeIds" separator="," open="(" close=")" index="">
                    #{typeId}
                </foreach>
            </if>

            <if test="params.sysObjectId != null">
                and model.sys_object_id = #{params.sysObjectId}
            </if>

            <if test="params.ids != null">
            	and model.id in 
				<foreach item="id" collection="params.ids" separator="," open="(" close=")" index="">
		       		#{id}
			    </foreach>
            </if>

            <if test="params.starred != null and params.starred != ''">
                AND
                <if test=' params.starred eq 1 '>
                    starred = #{params.starred}
                </if>
                <if test=' params.starred eq 0 '>
                    starred IS NULL
                </if>
            </if>

        </where>
		<if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY model.id
        </if>
    </select>

    <select id="nzAssetNumsMetric" resultType="com.nis.modules.metric.dto.MetricsDto">
        SELECT
            model.name AS model,
            brand.name AS brand,
            state.name AS state,
            type.name AS type,
            count( asset.id ) as total
        FROM
            asset_asset asset
            LEFT JOIN asset_state_conf state ON asset.state_id = state.id
            LEFT JOIN asset_type_conf type ON asset.type_id = type.id
            LEFT JOIN asset_model model ON model.id = asset.model_id
            LEFT JOIN asset_brand brand ON model.brand_id = brand.id
        GROUP BY
            model.id,
            state.id,
            type.id
    </select>

    <insert id="insertModel">
        INSERT INTO `asset_model`(`id`, `brand_id`, `name`, `remark`, `seq`, `usize`, `chart_ids`,`type_id`,`sys_object_id`)
        VALUES
        (#{model.id}, #{model.brandId}, #{model.name}, #{model.remark},#{model.seq}, #{model.usize}, #{model.chartIds},#{model.typeId},#{model.sysObjectId});
    </insert>
</mapper>
