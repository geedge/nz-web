<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.AssetFieldMetaDao">
	<resultMap type="com.nis.modules.asset.entity.AssetFieldMeta" id="assetFieldMeta">
		<result property="id" column="id"/>
		<result property="name" column="name" />
		<result property="metaKey" column="meta_key" />
		<result property="groupId" column="group_id" />
		<result property="search" column="search" />
		<result property="display" column="display" />
		<result property="type" column="type" />
		<result property="param" column="param" />
		<result property="remark" column="remark" />
		<result property="assetId" column="asset_id" />
		<result property="starred" column="starred" />
		<association columnPrefix="afg_" property="group" javaType="com.nis.modules.asset.entity.AssetFieldGroup">
	    	<id column="id" property="id"/>
	    	<result column="name" property="name"/>
	    	<result column="remark" property="remark"/>
	    </association>
	</resultMap>
    
    <resultMap type="com.nis.modules.asset.entity.AssetFieldMeta" id="assetFieldMetaDetail">
		<result property="id" column="id"/>
		<result property="name" column="name" />
		<result property="metaKey" column="meta_key" />
		<result property="groupId" column="group_id" />
		<result property="search" column="search" />
		<result property="display" column="display" />
		<result property="type" column="type" />
		<result property="param" column="param" />
		<result property="remark" column="remark" />
		<result property="assetId" column="asset_id" />
		<association columnPrefix="afg_" property="group" javaType="com.nis.modules.asset.entity.AssetFieldGroup">
	    	<id column="id" property="id"/>
	    	<result column="name" property="name"/>
	    	<result column="remark" property="remark"/>
	    </association>
	    <collection property="value" ofType="string" javaType="list">
     		<result column="val" />
   		</collection>
	</resultMap>
    
    <select id="selectAssetFieldMeta" resultMap="assetFieldMeta">
    	select afm.id,
    	afm.name,
    	afm.meta_key,
    	afm.group_id,
    	afm.search,
    	afm.display,
    	afm.type,
    	afm.param,
    	afm.remark,
    	afg.name as afg_name,
    	afg.id as afg_id,
		IF(COUNT( sta.tid ) > 0, 1, 0) AS starred
    	from asset_field_meta afm left join asset_field_group afg on afm.group_id = afg.id
		LEFT JOIN sys_user_starred sta ON afm.id = sta.tid AND sta.type = "assetFieldMeta" AND sta.uid = #{uid}
    	where afm.id = #{id}
    </select>
	
	
	<select id="selectAssetFieldMetaList" resultMap="assetFieldMeta">
    	select afm.id,
    	afm.name,
    	afm.meta_key,
    	afm.group_id,
    	afm.search,
    	afm.display,
    	afm.type,
    	afm.param,
    	afm.remark,
    	afg.name as afg_name,
    	afg.id as afg_id,
		IFNULL( sus.starred, 0 ) AS starred
    	from
		asset_field_meta afm left join asset_field_group afg on afm.group_id = afg.id
		LEFT JOIN ( SELECT IF(COUNT(1) > 0, 1, 0) AS starred,tid FROM sys_user_starred WHERE TYPE = "assetFieldMeta" AND uid = #{params.uid} GROUP BY tid) sus ON afm.id = sus.tid
    	where 1=1
    	<if test="params.ids != null">
            and afm.id in 
			<foreach item="id" collection="params.ids" separator="," open="(" close=")" index="">
		     		#{id}
		    </foreach>
        </if>
    	<if test="params.name!=null and params.name !=''">
    		and locate(#{params.name} , afm.name)
    	</if>
    	<if test="params.key!=null and params.key !=''">
    		and locate(#{params.key} , afm.meta_key)
    	</if>
    	<if test="params.groupIds!=null and params.groupIds.size>0">
    		and afm.group_id in 
    		<foreach collection="params.groupIds" item="groupId" index="no" open="(" separator="," close=")">
                #{groupId}
            </foreach>
    	</if>
    	<if test="params.search!=null">
    		and afm.search = #{params.search}
    	</if>
    	<if test="params.display!=null">
    		and afm.display = #{params.display}
    	</if>

		<if test="params.starred != null and params.starred != ''">
			AND
			<if test=' params.starred eq 1 '>
				sus.starred = #{params.starred}
			</if>
			<if test=' params.starred eq 0 '>
				sus.starred IS NULL
			</if>
		</if>

	</select>

	<select id="selectMateInfoListByAssetId" resultMap="assetFieldMetaDetail">
			SELECT
				me.*,
				va.value as val,
				va.asset_id,
				mg.id as afg_id,
				mg.name as afg_name
			FROM
				asset_field_value va
				LEFT JOIN asset_field_meta me ON va.meta_id = me.id
				LEFT JOIN asset_field_group mg ON me.group_id = mg.id

			<where>
				<if test="assetId != null and assetId != ''">
					va.asset_id =  #{assetId}
				</if>
			</where>
	</select>
	
</mapper>
