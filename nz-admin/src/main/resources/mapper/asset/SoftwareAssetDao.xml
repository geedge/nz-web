<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.SoftwareAssetDao">

    <resultMap id="softwareAssetInfo" type="com.nis.modules.asset.entity.SoftwareAsset">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="assetId" column="asset_id"/>
        <result property="typeId" column="type_id"/>
        <result property="params" column="params"/>
        <result property="dateIssued" column="date_issued"/>
        <result property="dateExpires" column="date_expires"/>
        <result property="concurrency" column="concurrency"/>
        <result property="logins" column="logins"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="buildIn" column="build_in"/>
        <result property="cts" column="cts"/>
        <result property="cid" column="cid"/>
        <result property="uts" column="uts"/>
        <result property="uid" column="uid"/>
        <result property="lastScanTs" column="last_scan_ts"/>
        <result property="lastScanMsg" column="last_scan_msg"/>

        <association property="asset" columnPrefix="ass_" javaType="com.nis.modules.asset.entity.AssetAsset">
            <result property="id" column="id"/>
            <result property="name" column="name"/>
        </association>

        <association property="type" columnPrefix="ty_" javaType="com.nis.modules.asset.entity.SoftwareType">
            <result property="id" column="id"/>
            <result property="name" column="name"/>
            <result property="category" column="category"/>
        </association>
    </resultMap>


    <select id="querySoftwareAssetInfoList" resultMap="softwareAssetInfo">
        SELECT
            sa.*,
            asset.id AS ass_id,
            asset.name AS ass_name,
            type.id as ty_id,
            type.name as ty_name,
            type.category as ty_category
        FROM
            software_asset sa
        LEFT JOIN asset_asset asset ON sa.asset_id = asset.id
        LEFT JOIN software_type type on sa.type_id = type.id
        <where>
            <if test="params.ids != null and params.ids != ''">
                sa.id in
                <foreach collection="params.ids.split(',')" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="params.status != null and params.status != ''">
                AND sa.status = #{params.status}
            </if>
            <if test="params.assetIds != null and params.assetIds != ''">
                AND sa.asset_id in
                <foreach collection="params.assetIds.split(',')" item="assetId" open="(" separator="," close=")">
                    #{assetId}
                </foreach>
            </if>
            <if test="params.typeIds != null and params.typeIds != ''">
                AND sa.type_id in
                <foreach collection="params.typeIds.split(',')" item="typeId" open="(" separator="," close=")">
                    #{typeId}
                </foreach>
            </if>
            <if test="params.name != null and params.name != ''">
                AND locate(#{params.name} , sa.name)
            </if>
        </where>
    </select>

</mapper>
