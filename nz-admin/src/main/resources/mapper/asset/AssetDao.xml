<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.asset.dao.AssetDao">

    <resultMap type="com.nis.modules.asset.entity.Asset" id="assetWithModelIdcCab">
        <result property="id" column="id"/>
        <result property="sn" column="sn"/>
        <result property="host" column="host"/>
        <result property="ipmi" column="ipmi"/>
        <result property="idcId" column="idc_id"/>
        <result property="cabinetId" column="cabinet_id"/>
        <result property="cabinetStart" column="cabinet_start"/>
        <result property="cabinetEnd" column="cabinet_end"/>
        <result property="state" column="state"/>
        <result property="purchaseDate" column="purchase_date"/>
        <result property="createAt" column="create_at"/>
        <result property="updateAt" column="update_at"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="pingState" column="pingState"/>
        <result property="pingRtt" column="pingRtt"/>
        <result property="pingLastUpdate" column="pingLastUpdate"/>

        <association property="model" column="model_id" columnPrefix="mo_" javaType="com.nis.modules.asset.entity.Model">
            <id property="id" column="id"/>
            <result property="name" column="name"/>
            <result property="usize" column="usize"/>
            <result property="remark" column="remark"/>
            <result property="typeCode" column="typeCode"/>
            <result property="vendorCode" column="vendorCode"/>
        </association>
    </resultMap>

    <sql id="asset_info_columns">
       ass.id,
       ass.sn,
       ass.model_id,
       ass.host,
       ass.ipmi,
       ass.idc_id,
       ass.cabinet_id,
       ass.cabinet_start,
       ass.cabinet_end,
       ass.state,
       ass.purchase_date,
       ass.create_at,
       ass.update_at,
       ass.create_by,
       ass.update_by,

       assp.status AS pingState,
       assp.rtt AS pingRtt,
       assp.last_update AS pingLastUpdate,

       mo.id AS mo_id,
       mo.name AS mo_name,
       mo.usize AS mo_usize,
       mo.remark AS mo_remark,
       mo.type AS mo_typeCode,
       mo.vendor AS mo_vendorCode
    </sql>

    <select id="queryList" resultMap="assetWithModelIdcCab">
        SELECT
        <include refid="asset_info_columns"/>
        FROM asset ass

        LEFT JOIN asset_ping assp ON ass.host = assp.host
        LEFT JOIN model mo ON ass.model_id = mo.id
        <where>

            <if test="params.id != null and params.id != ''">
                ass.id = #{params.id}
            </if>

            <if test="params.modelId != null and params.modelId != ''">
                AND ass.model_id = #{params.modelId}
            </if>

            <if test="params.innerModelIds != null and params.innerModelIds.size > 0">
                AND ass.model_id IN
                <foreach collection="params.innerModelIds" item="modelId" index="no" open="(" separator="," close=")">
                    #{modelId}
                </foreach>
            </if>

            <if test="params.idcId != null and params.idcId != ''">
                AND ass.idc_id = #{params.idcId}
            </if>

            <if test="params.idcIds != null and params.idcIds.length > 0">
                AND ass.idc_id IN
                <foreach collection="params.idcIds" item="idcId" index="no" open="(" separator="," close=")">
                    #{idcId}
                </foreach>
            </if>
            <if test="params.states !=null and params.states.length >0">
                AND ass.state IN
                <foreach collection="params.states" item="state" index="no" open="(" separator="," close=")">
                    #{state}
                </foreach>
            </if>
            <if test="params.cabinetId != null and params.cabinetId != ''">
                AND ass.cabinet_id = #{params.cabinetId}
            </if>

            <if test="params.state != null and params.state != ''">
                AND ass.state = #{params.state}
            </if>

            <if test="params.host != null and params.host != ''">
                AND ass.host like CONCAT('%', #{params.host}, '%')
            </if>

            <if test="params.sn != null and params.sn != ''">
                AND ass.sn like CONCAT('%', #{params.sn}, '%')
            </if>

            <if test="params.purchaseDate != null and params.purchaseDate != ''">
                AND ass.purchase_date like CONCAT('%', #{params.purchaseDate}, '%')
            </if>

            <if test="params.pingStatus != null and params.pingStatus != ''">
                AND assp.status = #{params.pingStatus}
            </if>
            <if test="params.pingStates !=null and params.pingStates.length >0">
                AND assp.status IN
                <foreach collection="params.pingStates" item="status" index="no" open="(" separator="," close=")">
                    #{status}
                </foreach>
            </if>

            <if test="params.innerTagRelationAssetIds != null and params.innerTagRelationAssetIds.size > 0">
                AND ass.id IN
                <foreach collection="params.innerTagRelationAssetIds" item="id" index="no" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

    <insert id="saveAsset">
        INSERT INTO asset (id, sn, model_id, idc_id, cabinet_id, cabinet_start, cabinet_end, host, state, purchase_date, create_at, update_at,
        create_by, update_by,ipmi)
        VALUES
        (NULL, #{asset.sn},#{asset.modelId},#{asset.idcId},#{asset.cabinetId},#{asset.cabinetStart},#{asset.cabinetEnd},#{asset.host},
        #{asset.state},#{asset.purchaseDate},#{asset.createAt},#{asset.updateAt},#{asset.createBy},#{asset.updateBy},#{asset.ipmi})

        <selectKey keyProperty="asset.id" order="AFTER" resultType="java.lang.Integer">
            SELECT LAST_INSERT_ID();
        </selectKey>
    </insert>

    <select id="selectAssetStatisticsByModel" resultType="com.nis.modules.metric.dto.MetricsDto">
		select count(*) total , m.name 
		from asset a left join model m on a.model_id=m.id 
		group by a.model_id
	</select>

    <select id="selectAssetStatisticsByModelOnLine" resultType="com.nis.modules.metric.dto.MetricsDto">
		select count(*) total , m.name 
		from asset a left join model m on a.model_id=m.id 
		where a.state=1
		group by a.model_id
	</select>

    <select id="selectAssetStatisticsByModelOffLine" resultType="com.nis.modules.metric.dto.MetricsDto">
		select count(*) total 
		from asset a 
		where a.state=2
	</select>


    <resultMap type="com.nis.modules.panel.entity.Chart" id="chartIdWithAssetEntity">
        <id property="id" column="chartId"/>

        <association property="asset" javaType="com.nis.modules.asset.entity.Asset">
            <id property="id" column="id"/>
            <result property="sn" column="sn"/>
            <result property="host" column="host"/>
        </association>
    </resultMap>

    <select id="getAssetsByChartIds" resultMap="chartIdWithAssetEntity">
            SELECT
                cha.id as chartId,
                ass.sn,
                ass.host
            FROM
                chart cha
                LEFT JOIN panel pan ON cha.panel_id = pan.id
                LEFT JOIN asset ass ON pan.link = ass.id
            WHERE
                cha.id IN
            <foreach collection="ids" item="id" index="no" open="(" separator="," close=")">
                #{id}
            </foreach>
    </select>

    <select id="getStatByDc" resultType="map">
        select idc_id as id,count(id) as total from asset group by idc_id
    </select>

    <select id="getStatByModel" resultType="map">
        SELECT
            ass.model_id AS id,
            count( ass.id ) AS total
        FROM
            asset ass
            LEFT JOIN model mo ON ass.model_id = mo.id
        GROUP BY
            ass.model_id
    </select>

    <select id="getAlertNumsMap" resultType="com.nis.modules.asset.entity.AssetStat">
        SELECT
            ass.id,
            count( am.id ) AS total
        FROM
            asset ass
            LEFT JOIN alert_message am ON ass.id = am.asset_id
        WHERE
            am.state = 1
        GROUP BY
            ass.id
    </select>
</mapper>