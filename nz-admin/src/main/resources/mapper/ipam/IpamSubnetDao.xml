<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.ipam.dao.IpamSubnetDao">
	<resultMap type="com.nis.modules.ipam.entity.IpamSubnet" id="ipamSubnet">
		<result property="id" column="id"/>
		<result property="name" column="name" />
		<result property="type" column="type" />
		<result property="addr" column="addr" />
		<result property="mask" column="mask" />
		<result property="vlan" column="vlan" />
		<result property="cap" column="cap" />
		<result property="dcId" column="dc_id" />
		<result property="remark" column="remark" />
		<result property="seq" column="seq" />
		
		<association property="dc" columnPrefix="dc_" javaType="com.nis.modules.asset.entity.Dc">
            <id column="id" property="id"/>
            <result column="name" property="name"/>
        </association>
	</resultMap>
    
    <select id="queryPage" resultMap="ipamSubnet">
    	select ipam.*,
    	dc.id as dc_id,
    	dc.name as dc_name
    	from ipam_subnet ipam left join dc on ipam.dc_id = dc.id
		<where>
            <if test="params.ids != null and params.ids.size > 0">
                ipam.id IN
                <foreach collection="params.ids" item="id" index="no" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>

            <if test="params.name != null and params.name != ''">
                AND locate(#{params.name} , ipam.name)
            </if>
            
            <if test="params.type != null">
                AND ipam.type = #{params.type}
            </if>
            
            <if test="params.addr != null and params.addr != ''">
                AND locate(#{params.addr} , ipam.addr)
            </if>
            
            <if test="params.vlan != null and params.vlan != ''">
                AND locate(#{params.vlan} , ipam.vlan)
            </if>
            
            <if test="params.dcIds != null and params.dcIds.size > 0">
                ipam.dc_id IN
                <foreach collection="params.dcIds" item="dcId" index="no" open="(" separator="," close=")">
                    #{dcId}
                </foreach>
            </if>
        </where>
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY ipam.id
        </if>
    </select>
</mapper>
