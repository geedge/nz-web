<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nis.modules.detectType.dao.DeteTypeInfoDao">
    <sql id="commonFields">
        <if test="_databaseId  == 'oracle'">
        </if>
        <if test="_databaseId  == 'mysql'">
            ,data_check_time timestamp DEFAULT current_timestamp(),
            data_arrive_time timestamp DEFAULT current_timestamp(),
            id bigint ,
            primary key (id)
            )ENGINE=InnoDB DEFAULT CHARSET=utf8 ROW_FORMAT=COMPACT

        </if>
        <if test="_databaseId  == 'postgresql'">
        </if>
    </sql>

    <select id="queryTables" parameterType="java.lang.String" resultType="java.util.HashMap" databaseId="mysql">
        <if test="_databaseId  == 'oracle'">
            SELECT
            t.TABLE_NAME AS name,
            c.COMMENTS AS comments
            FROM user_tables t, user_tab_comments c
            WHERE t.table_name = c.table_name
            <if test="tableName != null and tableName != ''">
                AND t.TABLE_NAME = upper(#{tableName})
            </if>
            ORDER BY t.TABLE_NAME
        </if>
        <if test="_databaseId  == 'mysql'">
            SELECT t.table_name AS name,t.TABLE_COMMENT AS comments
            FROM information_schema.`TABLES` t
            WHERE t.TABLE_SCHEMA = (select database())
            <if test="tableName != null and tableName != ''">
                AND t.TABLE_NAME = (#{tableName})
            </if>
            ORDER BY t.TABLE_NAME
        </if>
        <if test="_databaseId  == 'postgresql'">
            select pgt.tablename as name,pgd.description as comments
            from pg_tables pgt
            join pg_class pgc on
            pgt.tablename=pgc.relname
            and pgt.schemaname='public'
            <if test="tableName != null and tableName != ''">
                AND pgt.tablename = #{tableName}
            </if>
            left join pg_description pgd on
            pgd.objoid=pgc.oid and pgd.objsubid=0
        </if>
    </select>

    <update id="createTable">
        <if test="_databaseId  == 'oracle'">
            create table ${tableName}
            <if test="deteTypeMetas != null and deteTypeMetas.size > 0">
                <foreach collection="deteTypeMetas" item="meta" open="(" close=")" index="idx">
                    ${meta.fieldName}
                    <if test="meta.fieldType != null and meta.fieldType != 3"><!--fieldType==3 表示为临时字段，不在数据库存储-->
                        <choose>
                            <when test="meta.dataType !=null and meta.dataType == 1 or meta.dataType == 2"> <!-- dataType==1 counter 字段 dataType==2 瞬时值-->
                                decimal(
                                <if test="meta.dataLenth !=null and meta.dataLenth >= 2"><!--数据库整数位长度要>= 小数位-->
                                    ${meta.dataLenth}
                                </if>
                                <if test="meta.dataLenth ==null or meta.dataLenth lt 2">
                                    65
                                </if>
                                ,${meta.decimalPointLimit})
                            </when>
                            <otherwise>
                                varchar (
                                <if test="meta.dataLenth !=null ">
                                    ${meta.dataLenth}
                                </if>
                                <if test="meta.dataLenth ==null">
                                    255
                                </if>
                                )
                            </otherwise>
                        </choose>
                        <if test="idx != deteTypeMetas.size -1 "> <!--fieldType==1 此字段需要加索引-->
                            ,
                        </if>
                        <include refid="commonFields"/>
                    </if>
                </foreach>;
                <foreach collection="deteTypeMetas" item="meta" >
                    create index ${tableName}_${meta.fieldName}_INDEX on ${tableName} (${meta.fieldName});
                </foreach>
                <foreach collection="deteTypeMetas" item="meta" >
                    <if test="meta.remark != null">
                        COMMENT ON COLUMN ${tableName}.${meta.fieldName} IS #{meta.remark};
                    </if>
                </foreach>
            </if>
        </if>
        <if test="_databaseId  == 'mysql'">
            create table ${tableName}
            <if test="deteTypeMetas != null and deteTypeMetas.size > 0">
                <foreach collection="deteTypeMetas" item="meta" open="("  index="idx">
                    ${meta.fieldName}
                    <if test="meta.fieldType != null and meta.fieldType != 3"><!--fieldType==3 表示为临时字段，不在数据库存储-->
                        <choose>
                            <when test="meta.dataType !=null and meta.dataType == 1 or meta.dataType == 2"> <!-- dataType==1 counter 字段 dataType==2 瞬时值-->
                                decimal(
                                <if test="meta.dataLenth !=null and meta.dataLenth >= 2"><!--数据库整数位长度要>= 小数位-->
                                    ${meta.dataLenth}
                                </if>
                                <if test="meta.dataLenth ==null or meta.dataLenth lt 2">
                                    65
                                </if>
                                ,${meta.decimalPointLimit})
                            </when>
                            <otherwise>
                                varchar (
                                <if test="meta.dataLenth !=null ">
                                    ${meta.dataLenth}
                                </if>
                                <if test="meta.dataLenth ==null">
                                    255
                                </if>
                                )
                            </otherwise>
                        </choose>
                        <if test="meta.remark !=null">
                            COMMENT #{meta.remark}
                        </if>
                        <if test="idx != deteTypeMetas.size -1 or meta.fieldType == 1">
                            ,
                        </if>
                        <if test="meta.fieldType == 1 and idx != deteTypeMetas.size -1"><!--fieldType==1 此字段需要加索引-->
                            index ${tableName}_${meta.fieldName}_INDEX(${meta.fieldName}),
                        </if>
                        <if test="meta.fieldType == 1 and idx == deteTypeMetas.size -1">
                            index ${tableName}_${meta.fieldName}_INDEX(${meta.fieldName})
                        </if>
                    </if>
                </foreach>
                <include refid="commonFields"/>
                COMMENT= #{remark}
            </if>
        </if>
        <if test="_databaseId  == 'postgresql'">
            create table ${tableName}
            <if test="deteTypeMetas != null and deteTypeMetas.size > 0">
                <foreach collection="deteTypeMetas" item="meta" open="(" close=")" index="idx">
                    ${meta.fieldName}
                    <if test="meta.fieldType != null and meta.fieldType != 3"><!--fieldType==3 表示为临时字段，不在数据库存储-->
                        <choose>
                            <when test="meta.dataType !=null and meta.dataType == 1 or meta.dataType == 2"> <!-- dataType==1 counter 字段 dataType==2 瞬时值-->
                                number(
                                <if test="meta.dataLenth !=null and meta.dataLenth >= 2"><!--数据库整数位长度要>= 小数位-->
                                    ${meta.dataLenth}
                                </if>
                                <if test="meta.dataLenth ==null or meta.dataLenth lt 2">
                                    65
                                </if>
                                ,${meta.decimalPointLimit})
                            </when>
                            <otherwise>
                                varchar (
                                <if test="meta.dataLenth !=null ">
                                    ${meta.dataLenth}
                                </if>
                                <if test="meta.dataLenth ==null">
                                    255
                                </if>
                                )
                            </otherwise>
                        </choose>
                        <if test="idx != deteTypeMetas.size -1 "> <!--fieldType==1 此字段需要加索引-->
                            ,
                        </if>
                        <include refid="commonFields"/>
                    </if>
                </foreach>;
                <foreach collection="deteTypeMetas" item="meta" >
                    create index ${tableName}_${meta.fieldName}_INDEX on ${tableName} (${meta.fieldName});
                </foreach>
                <!--<foreach collection="deteTypeMetas" item="meta" >
                    <if test="meta.remark != null">
                        COMMENT ON COLUMN ${tableName}.${meta.fieldName} IS #{meta.remark};
                    </if>
                </foreach>-->
            </if>
        </if>

    </update>
</mapper>